{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Éditer Paroisse' : 'Nouvelle Paroisse' }} - Administration{% endblock %}
{% block header_title %}{{ isEdit ? 'Édition de la Paroisse' : 'Création d\'une Nouvelle Paroisse' }}{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
    <form method="POST" class="space-y-5">
        <div>
            <label for="nom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom de la Paroisse *</label>
            <input type="text" id="nom" name="nom" value="{{ fiangonana ? fiangonana.nom : '' }}" required placeholder="Ex: Paroisse de Behoririka" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
        </div>

        <div>
            <label for="code" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Code Unique *</label>
            <input type="text" id="code" name="code" value="{{ fiangonana ? fiangonana.code : '' }}" required placeholder="Ex: BEHO" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm font-mono uppercase">
            <p class="text-[11px] text-slate-400 mt-1">Le code doit être unique et comporter quelques lettres majuscules.</p>
        </div>

        <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
            <a href="/admin/fiangonana" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                {{ isEdit ? 'Enregistrer les Modifications' : 'Créer la Paroisse' }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
