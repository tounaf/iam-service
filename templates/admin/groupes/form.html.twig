{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Éditer Zone Géographique' : 'Nouvelle Zone Géographique' }} - Administration{% endblock %}
{% block header_title %}{{ isEdit ? 'Édition de la Zone Géographique' : 'Création d\'une Nouvelle Zone' }}{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
    <form method="POST" class="space-y-5">
        <div>
            <label for="nom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom de la Zone / Groupe *</label>
            <input type="text" id="nom" name="nom" value="{{ groupe ? groupe.nom : '' }}" required placeholder="Ex: Zone Behoririka Centre" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
        </div>

        <div>
            <label for="fiangonana_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Paroisse de rattachement *</label>
            <select id="fiangonana_id" name="fiangonana_id" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                <option value="">-- Sélectionner la paroisse --</option>
                {% for f in fiangonanas %}
                    <option value="{{ f.id }}" {% if groupe and groupe.fiangonana and groupe.fiangonana.id == f.id %}selected{% endif %}>{{ f.nom }} ({{ f.code }})</option>
                {% endfor %}
            </select>
        </div>

        <div>
            <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description</label>
            <textarea id="description" name="description" rows="3" placeholder="Secteur résidentiel couvrant les quartiers ..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">{{ groupe ? groupe.description : '' }}</textarea>
        </div>

        <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
            <a href="/admin/groupes" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                {{ isEdit ? 'Enregistrer les Modifications' : 'Créer la Zone' }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
