{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de Bord - Administration Paroissiale{% endblock %}
{% block header_title %}Tableau de Bord Administrateur{% endblock %}

{% block body %}
<!-- KPI Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Card 1: Total Membres -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Membres</p>
            <h3 class="text-3xl font-extrabold text-slate-900 mt-2">{{ totalMembres }}</h3>
            <p class="text-xs text-emerald-600 font-medium mt-1"><i class="fa-solid fa-arrow-up mr-1"></i>Actifs en base</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-users"></i>
        </div>
    </div>

    <!-- Card 2: Zones Géographiques -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Zones Géographiques</p>
            <h3 class="text-3xl font-extrabold text-slate-900 mt-2">{{ totalGroupes }}</h3>
            <p class="text-xs text-indigo-600 font-medium mt-1">Secteurs paroissiaux</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-map-location-dot"></i>
        </div>
    </div>

    <!-- Card 3: Associations -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Associations Interne</p>
            <h3 class="text-3xl font-extrabold text-slate-900 mt-2">{{ totalAssociations }}</h3>
            <p class="text-xs text-blue-600 font-medium mt-1">Chorales & Groupes</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-people-group"></i>
        </div>
    </div>

    <!-- Card 4: Total Présences / Scans -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Scans Présence</p>
            <h3 class="text-3xl font-extrabold text-slate-900 mt-2">{{ totalPresences }}</h3>
            <p class="text-xs text-amber-600 font-medium mt-1">Pointages effectués</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-qrcode"></i>
        </div>
    </div>
</div>

<!-- Section Activity & Quick Links -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Recent Scans / Presences Table -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-slate-800">Derniers Pointages de Présence</h3>
            <a href="/admin/presences" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Voir tout <i class="fa-solid fa-chevron-right text-[10px]"></i></a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-400 border-b border-slate-100">
                    <tr>
                        <th class="py-3 px-4">Membre</th>
                        <th class="py-3 px-4">Événement / Activité</th>
                        <th class="py-3 px-4">Date & Heure</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for p in recentPresences %}
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-3 px-4 font-semibold text-slate-800">{{ p.membre.prenom }} {{ p.membre.nom }}</td>
                            <td class="py-3 px-4"><span class="px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100">{{ p.activityName }}</span></td>
                            <td class="py-3 px-4 text-xs text-slate-500">{{ p.scannedAt|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="py-6 text-center text-slate-400 text-sm">Aucun pointage récent enregistré.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick Management Panel -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
        <h3 class="text-base font-bold text-slate-800 mb-2">Actions Rapides</h3>

        <a href="/admin/membres/nouveau" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-xl flex items-center justify-center space-x-2 transition shadow-sm">
            <i class="fa-solid fa-user-plus"></i>
            <span>Inscrire un nouveau membre</span>
        </a>

        <a href="/admin/membres" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-4 rounded-xl flex items-center justify-center space-x-2 transition">
            <i class="fa-solid fa-id-card"></i>
            <span>Gérer les Cartes Membres</span>
        </a>

        <a href="/admin/presences" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-4 rounded-xl flex items-center justify-center space-x-2 transition">
            <i class="fa-solid fa-chart-column"></i>
            <span>Rapport de Participation Annuel</span>
        </a>
    </div>
</div>
{% endblock %}
