{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Éditer Association' : 'Nouvelle Association' }} - Administration{% endblock %}
{% block header_title %}{{ isEdit ? 'Édition de l\'Association' : 'Création d\'une Nouvelle Association' }}{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
    <form method="POST" class="space-y-5">
        <div>
            <label for="nom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom de l'Association *</label>
            <input type="text" id="nom" name="nom" value="{{ association ? association.nom : '' }}" required placeholder="Ex: Chorale Tanora Behoririka" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
        </div>

        <div>
            <label for="fiangonana_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Paroisse de rattachement *</label>
            <select id="fiangonana_id" name="fiangonana_id" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                <option value="">-- Sélectionner la paroisse --</option>
                {% for f in fiangonanas %}
                    <option value="{{ f.id }}" {% if association and association.fiangonana and association.fiangonana.id == f.id %}selected{% endif %}>{{ f.nom }} ({{ f.code }})</option>
                {% endfor %}
            </select>
        </div>

        <div>
            <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description / Activités</label>
            <textarea id="description" name="description" rows="3" placeholder="Description de la mission ou branche d'activité..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">{{ association ? association.description : '' }}</textarea>
        </div>

        <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
            <a href="/admin/associations" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                {{ isEdit ? 'Enregistrer les Modifications' : 'Créer l\'Association' }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
