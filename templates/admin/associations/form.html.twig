{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Fiche & Édition Association' : 'Nouvelle Association' }} - Administration{% endblock %}
{% block header_title %}{{ isEdit ? 'Fiche Association' : 'Création d\'une Nouvelle Association' }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-6">

    {% if isEdit and association %}
        <!-- Header Association Banner -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center space-x-5">
                <div class="w-16 h-16 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-2xl border border-indigo-200 shadow-inner">
                    <i class="fa-solid fa-people-group text-2xl"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-3">
                        <h2 class="text-2xl font-extrabold text-slate-800">{{ association.nom }}</h2>
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">{{ association.fiangonana.nom }}</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-users mr-1"></i> {{ membres|length }} membre(s) inscrit(s)</p>
                </div>
            </div>
        </div>

        <!-- Tab Navigation Bar -->
        <div class="border-b border-slate-200 flex space-x-4 text-sm font-semibold">
            <button onclick="switchTab('tab-general')" id="tab-btn-general" class="tab-link pb-3 border-b-2 border-indigo-600 text-indigo-600 flex items-center space-x-2 transition">
                <i class="fa-solid fa-circle-info"></i>
                <span>Informations Générales</span>
            </button>
            <button onclick="switchTab('tab-membres')" id="tab-btn-membres" class="tab-link pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2 transition">
                <i class="fa-solid fa-users"></i>
                <span>Membres Inscrits ({{ membres|length }})</span>
            </button>
            <button onclick="switchTab('tab-comites')" id="tab-btn-comites" class="tab-link pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2 transition">
                <i class="fa-solid fa-user-gear"></i>
                <span>Bureau & Comités ({{ roleAssignments|length }})</span>
            </button>
            <button onclick="switchTab('tab-events')" id="tab-btn-events" class="tab-link pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2 transition">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Événements & Présences ({{ events|length }})</span>
            </button>
        </div>
    {% endif %}

    <!-- TAB 1: General Info -->
    <div id="tab-general" class="tab-content bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-6">
        <form method="POST" class="space-y-5">
            <div>
                <label for="nom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom de l'Association *</label>
                <input type="text" id="nom" name="nom" value="{{ association ? association.nom : '' }}" required placeholder="Ex: Sampana Tanora (STK)" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
            </div>

            <div>
                <label for="fiangonana_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Paroisse de rattachement *</label>
                <select id="fiangonana_id" name="fiangonana_id" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                    <option value="">-- Sélectionner une paroisse --</option>
                    {% for f in fiangonanas %}
                        <option value="{{ f.id }}" {{ association and association.fiangonana and association.fiangonana.id == f.id ? 'selected' : '' }}>
                            {{ f.nom }} ({{ f.code }})
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description</label>
                <textarea id="description" name="description" rows="3" placeholder="Description des activités de l'association..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">{{ association ? association.description : '' }}</textarea>
            </div>

            <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
                <a href="/admin/associations" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                    {{ isEdit ? 'Enregistrer les Modifications' : 'Créer l\'Association' }}
                </button>
            </div>
        </form>
    </div>

    {% if isEdit and association %}
        <!-- TAB 2: Members List -->
        <div id="tab-membres" class="tab-content hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-4">
            <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Membres inscrits dans cette Association</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-400 border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-6">ID & Nom</th>
                            <th class="py-3.5 px-6">Contact</th>
                            <th class="py-3.5 px-6">Paroisse</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for m in membres %}
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-4 px-6 font-bold text-slate-800">#{{ m.id }} - {{ m.prenom }} {{ m.nom }}</td>
                                <td class="py-4 px-6 text-xs">{{ m.email|default('N/A') }}</td>
                                <td class="py-4 px-6 text-xs font-medium">{{ m.fiangonana ? m.fiangonana.nom : 'N/A' }}</td>
                                <td class="py-4 px-6 text-right">
                                    <a href="/admin/membres/{{ m.id }}/editer" class="text-indigo-600 hover:underline font-semibold text-xs"><i class="fa-solid fa-pen-to-square"></i> Éditer</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="py-6 text-center text-slate-400">Aucun membre inscrit dans cette association.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: Committee & Bureau (CRBAC Roles) -->
        <div id="tab-comites" class="tab-content hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-4">
            <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Membres du Bureau & Comités de l'Association</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-400 border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-6">Membre Mandaté</th>
                            <th class="py-3.5 px-6">Poste / Rôle</th>
                            <th class="py-3.5 px-6">Exercice</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for ra in roleAssignments %}
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-4 px-6 font-bold text-slate-800">{{ ra.membre.prenom }} {{ ra.membre.nom }}</td>
                                <td class="py-4 px-6"><span class="px-3 py-1 rounded-lg text-xs font-mono font-extrabold bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase">{{ ra.role.name }}</span></td>
                                <td class="py-4 px-6 text-xs font-mono">{{ ra.exerciceYear }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="py-6 text-center text-slate-400">Aucun rôle de bureau attribué dans le contexte de cette association.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: Events & Presences -->
        <div id="tab-events" class="tab-content hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-6">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div>
                    <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Gestion des Événements de l'Association</h4>
                    <p class="text-xs text-slate-500 mt-1">Créer un événement propre à cette association et suivre les présences</p>
                </div>
            </div>

            <!-- Add Event Form -->
            <div class="bg-indigo-50/50 border border-indigo-100 rounded-2xl p-5 space-y-3">
                <h5 class="text-xs font-bold text-indigo-900 uppercase tracking-wider"><i class="fa-solid fa-calendar-plus mr-1"></i> Créer un nouvel événement d'association</h5>
                <form action="/admin/associations/{{ association.id }}/nouvel-evenement" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <input type="text" name="nom" required placeholder="Nom de l'événement *" class="px-4 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 text-sm">
                    <select name="type_evenement_id" class="px-4 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 text-sm bg-white">
                        <option value="">-- Type d'événement --</option>
                        {% for t in typesEvenement %}
                            <option value="{{ t.id }}">{{ t.nom }}</option>
                        {% endfor %}
                    </select>
                    <input type="text" name="lieu" placeholder="Lieu" class="px-4 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 text-sm">

                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">Date Début</label>
                        <input type="datetime-local" name="date_debut" class="w-full px-3 py-1.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">Date Fin</label>
                        <input type="datetime-local" name="date_fin" class="w-full px-3 py-1.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 text-xs">
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs uppercase tracking-wider transition">
                            <i class="fa-solid fa-plus mr-1"></i> Créer l'Événement
                        </button>
                    </div>
                </form>
            </div>

            <!-- List of Created Events -->
            {% if evenements %}
                <div class="space-y-3">
                    <h5 class="text-xs font-bold text-slate-700 uppercase">Événements créés pour cette association :</h5>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                        {% for ev in evenements %}
                            <div class="bg-white border border-slate-200 rounded-xl p-4 space-y-1">
                                <div class="flex items-center justify-between">
                                    <p class="text-xs font-bold text-slate-800"><i class="fa-solid fa-calendar-day text-indigo-500 mr-1.5"></i>{{ ev.nom }}</p>
                                    {% if ev.typeEvenement %}
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-indigo-50 text-indigo-700 border border-indigo-100">{{ ev.typeEvenement.nom }}</span>
                                    {% endif %}
                                </div>
                                <p class="text-[11px] text-slate-500"><i class="fa-solid fa-location-dot mr-1"></i>Lieu: {{ ev.lieu|default('Non spécifié') }}</p>
                                {% if ev.dateDebut %}
                                    <p class="text-[11px] text-indigo-600 font-medium"><i class="fa-solid fa-clock mr-1"></i>{{ ev.dateDebut|date('d/m/Y H:i') }}{% if ev.dateFin %} - {{ ev.dateFin|date('H:i') }}{% endif %}</p>
                                {% endif %}
                                <p class="text-[10px] text-slate-400 font-mono">Créé le {{ ev.createdAt|date('d/m/Y') }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <!-- Grouped Presences by Event/Activity Name -->
            <div class="space-y-4 pt-2 border-t border-slate-100">
                <h5 class="text-xs font-bold text-slate-700 uppercase">Pointages et Présences :</h5>
                {% for event in events %}
                    <div class="border border-slate-200 rounded-xl p-5 space-y-3 bg-slate-50/50">
                        <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                            <span class="font-bold text-slate-800 text-sm"><i class="fa-solid fa-star text-amber-500 mr-2"></i>{{ event.name }}</span>
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">{{ event.presences|length }} membre(s) présent(s)</span>
                        </div>
                        <div class="space-y-1">
                            {% for p in event.presences %}
                                <div class="flex items-center justify-between text-xs py-1 border-b border-slate-100 last:border-0">
                                    <span class="font-medium text-slate-700">{{ p.membre.prenom }} {{ p.membre.nom }}</span>
                                    <span class="text-slate-400 font-mono text-[11px]">{{ p.scannedAt|date('d/m/Y H:i') }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <p class="py-6 text-center text-slate-400 text-xs">Aucun événement enregistré avec présences pour cette association.</p>
                {% endfor %}
            </div>
        </div>
    {% endif %}

</div>

{% block javascripts %}
<script>
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.tab-link').forEach(el => {
            el.classList.remove('border-indigo-600', 'text-indigo-600');
            el.classList.add('border-transparent', 'text-slate-500');
        });

        document.getElementById(tabId).classList.remove('hidden');
        const btn = document.getElementById('tab-btn-' + tabId.replace('tab-', ''));
        if (btn) {
            btn.classList.remove('border-transparent', 'text-slate-500');
            btn.classList.add('border-indigo-600', 'text-indigo-600');
        }
    }
</script>
{% endblock %}
{% endblock %}
