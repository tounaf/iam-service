{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Éditer Rôle' : 'Nouveau Rôle' }} - Administration{% endblock %}
{% block header_title %}{{ isEdit ? 'Édition du Rôle' : 'Création d\'un Nouveau Rôle' }}{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
    <form method="POST" class="space-y-5">
        <div>
            <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom / Code du Rôle *</label>
            <input type="text" id="name" name="name" value="{{ role ? role.name : '' }}" required placeholder="Ex: PRESIDENT, CAISSIER" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm font-mono uppercase">
            <p class="text-[11px] text-slate-400 mt-1">Le nom sera automatiquement converti en majuscules.</p>
        </div>

        <div>
            <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description des Responsabilités</label>
            <textarea id="description" name="description" rows="3" placeholder="Responsable de la gestion financière ou administrative..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">{{ role ? role.description : '' }}</textarea>
        </div>

        <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
            <a href="/admin/roles" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                {{ isEdit ? 'Enregistrer les Modifications' : 'Créer le Rôle' }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
