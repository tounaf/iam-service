{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Éditer Membre' : 'Inscrire un Membre' }} - Administration Paroissiale{% endblock %}
{% block header_title %}{{ isEdit ? 'Édition d\'un Membre' : 'Inscription d\'un Nouveau Membre' }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
    <form method="POST" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label for="nom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom *</label>
                <input type="text" id="nom" name="nom" value="{{ membre ? membre.nom : '' }}" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
            </div>
            <div>
                <label for="prenom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Prénom *</label>
                <input type="text" id="prenom" name="prenom" value="{{ membre ? membre.prenom : '' }}" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Adresse Email</label>
                <input type="email" id="email" name="email" value="{{ membre ? membre.email : '' }}" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
            </div>
            <div>
                <label for="telephone" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Téléphone</label>
                <input type="text" id="telephone" name="telephone" value="{{ membre ? membre.telephone : '' }}" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
            </div>
        </div>

        <div>
            <label for="groupe_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Zone Géographique / Groupe</label>
            <select id="groupe_id" name="groupe_id" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                <option value="">-- Sélectionner une zone --</option>
                {% for g in groupes %}
                    <option value="{{ g.id }}" {% if membre and membre.zoneGeographique and membre.zoneGeographique.id == g.id %}selected{% endif %}>{{ g.nom }}</option>
                {% endfor %}
            </select>
        </div>

        <div>
            <label for="fiangonana_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Paroisse / Église</label>
            <select id="fiangonana_id" name="fiangonana_id" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                {% for f in fiangonanas %}
                    <option value="{{ f.id }}" {% if membre and membre.fiangonana and membre.fiangonana.id == f.id %}selected{% endif %}>{{ f.nom }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
            <a href="/admin/membres" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                {{ isEdit ? 'Enregistrer les Modifications' : 'Créer le Membre' }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
