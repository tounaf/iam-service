{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'Fiche & Édition Membre' : 'Inscrire un Membre' }} - Administration{% endblock %}
{% block header_title %}{{ isEdit ? 'Fiche Membre & Gestion' : 'Inscription d\'un Nouveau Membre' }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-6">

    {% if isEdit and membre %}
        <!-- Header Member Banner -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center space-x-5">
                <div class="relative">
                    {% if membre.photoUrl %}
                        <img src="{{ membre.photoUrl }}" alt="Photo {{ membre.prenom }}" class="w-20 h-28 object-cover rounded-2xl border border-slate-200 shadow-sm">
                    {% else %}
                        <div class="w-20 h-28 rounded-2xl bg-indigo-100 text-indigo-700 flex flex-col items-center justify-center font-bold text-2xl border border-indigo-200 shadow-inner">
                            <i class="fa-solid fa-user text-3xl"></i>
                        </div>
                    {% endif %}
                </div>
                <div>
                    <div class="flex items-center space-x-3">
                        <h2 class="text-2xl font-extrabold text-slate-800">{{ membre.prenom }} {{ membre.nom }}</h2>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">ID #{{ membre.id }}</span>
                        {% if membre.age is not null %}
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">{{ membre.age }} ans</span>
                        {% endif %}
                    </div>
                    <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-church mr-1"></i> {{ membre.fiangonana ? membre.fiangonana.nom : 'Paroisse non spécifiée' }}</p>
                    <p class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-map-location-dot mr-1"></i> Zone : {{ membre.zoneGeographique ? membre.zoneGeographique.nom : 'Non spécifiée' }}</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <a href="/api/membres/{{ membre.id }}/carte" target="_blank" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center space-x-2 transition shadow-sm">
                    <i class="fa-solid fa-id-card"></i>
                    <span>Imprimer Carte</span>
                </a>
                <a href="/api/membres/{{ membre.id }}/participation-stats" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center space-x-2 transition shadow-sm">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Stats Assiduité</span>
                </a>
            </div>
        </div>

        <!-- Tab Navigation Bar -->
        <div class="border-b border-slate-200 flex space-x-4 text-sm font-semibold">
            <button onclick="switchTab('tab-general')" id="tab-btn-general" class="tab-link pb-3 border-b-2 border-indigo-600 text-indigo-600 flex items-center space-x-2 transition">
                <i class="fa-solid fa-id-badge"></i>
                <span>Informations Générales & QR Code</span>
            </button>
            <button onclick="switchTab('tab-roles')" id="tab-btn-roles" class="tab-link pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2 transition">
                <i class="fa-solid fa-user-shield"></i>
                <span>Associations & Rôles CRBAC</span>
            </button>
            <button onclick="switchTab('tab-presence')" id="tab-btn-presence" class="tab-link pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2 transition">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Historique des Présences ({{ presences|length }})</span>
            </button>
            <button onclick="switchTab('tab-finances')" id="tab-btn-finances" class="tab-link pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2 transition">
                <i class="fa-solid fa-hand-holding-dollar"></i>
                <span>Cotisations ({{ monthsPaidCount }}/12 mois) & Dons</span>
            </button>
        </div>
    {% endif %}

    <!-- TAB 1: General Info & QR Code -->
    <div id="tab-general" class="tab-content bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-6">
        <form method="POST" class="space-y-5">
            <input type="hidden" name="form_action" value="update_info">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label for="nom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Nom *</label>
                    <input type="text" id="nom" name="nom" value="{{ membre ? membre.nom : '' }}" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
                </div>
                <div>
                    <label for="prenom" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Prénom *</label>
                    <input type="text" id="prenom" name="prenom" value="{{ membre ? membre.prenom : '' }}" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div>
                    <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Adresse Email *</label>
                    <input type="email" id="email" name="email" value="{{ membre ? membre.email : '' }}" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
                </div>
                <div>
                    <label for="telephone" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Téléphone</label>
                    <input type="text" id="telephone" name="telephone" value="{{ membre ? membre.telephone : '' }}" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
                </div>
                <div>
                    <label for="dateNaissance" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Date de Naissance</label>
                    <input type="date" id="dateNaissance" name="dateNaissance" value="{{ membre and membre.dateNaissance ? membre.dateNaissance|date('Y-m-d') : '' }}" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
                </div>
            </div>

            <div>
                <label for="photoUrl" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">URL / Chemin de la Photo de Profil</label>
                <input type="text" id="photoUrl" name="photoUrl" value="{{ membre ? membre.photoUrl : '' }}" placeholder="https://example.com/photos/membre.jpg" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label for="fiangonana_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Paroisse / Église *</label>
                    <select id="fiangonana_id" name="fiangonana_id" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                        <option value="">-- Sélectionner une paroisse --</option>
                        {% for f in fiangonanas %}
                            <option value="{{ f.id }}" {% if membre and membre.fiangonana and membre.fiangonana.id == f.id %}selected{% endif %}>{{ f.nom }} ({{ f.code }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="groupe_id" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Zone Géographique / Groupe</label>
                    <select id="groupe_id" name="groupe_id" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 text-sm bg-white">
                        <option value="">-- Sélectionner une zone --</option>
                        {% for g in groupes %}
                            <option value="{{ g.id }}" {% if membre and membre.zoneGeographique and membre.zoneGeographique.id == g.id %}selected{% endif %}>{{ g.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            {% if not isEdit %}
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Adhésion directe aux Associations Interne</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                        {% for a in associations %}
                            <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition">
                                <input type="checkbox" name="association_ids[]" value="{{ a.id }}" class="w-4 h-4 text-indigo-600 rounded border-slate-300">
                                <div>
                                    <p class="text-xs font-bold text-slate-800">{{ a.nom }}</p>
                                    <p class="text-[10px] text-slate-400">{{ a.fiangonana ? a.fiangonana.nom : '' }}</p>
                                </div>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100">
                <a href="/admin/membres" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Annuler</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition shadow-sm">
                    {{ isEdit ? 'Enregistrer les Informations' : 'Inscrire le Membre' }}
                </button>
            </div>
        </form>

        <!-- QR Code Section Outside Main Info Form -->
        {% if isEdit and membre %}
            <div class="pt-6 border-t border-slate-100">
                <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-3">Gestion du Code QR Unique</h4>
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                    {% if membre.qrCodeToken %}
                        <!-- QR Code Generated Display -->
                        <div class="flex items-center space-x-4">
                            <img src="/api/membres/{{ membre.id }}/qr-code" alt="Code QR Membre" class="w-24 h-28 border border-slate-200 rounded-xl bg-white p-1">
                            <div>
                                <p class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md inline-block border border-emerald-100 mb-1"><i class="fa-solid fa-check-circle mr-1"></i> Code QR Généré & Actif</p>
                                <p class="text-xs text-slate-500 font-mono">Jeton : {{ membre.qrCodeToken }}</p>
                                <p class="text-[11px] text-slate-400 mt-0.5">Scannable lors des cultes, formations des jeunes et événements.</p>
                            </div>
                        </div>
                    {% else %}
                        <!-- Generate QR Code Button -->
                        <div>
                            <p class="text-xs font-semibold text-slate-700">Aucun code QR unique attribué à ce membre.</p>
                            <p class="text-[11px] text-slate-400">Générez un jeton sécurisé pour permettre le pointage aux événements.</p>
                        </div>
                        <form method="POST" action="/admin/membres/{{ membre.id }}/generate-qrcode">
                            <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs px-4 py-2.5 rounded-xl flex items-center space-x-2 transition shadow-sm">
                                <i class="fa-solid fa-qrcode"></i>
                                <span>Générer le Code QR</span>
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>

    {% if isEdit and membre %}
        <!-- TAB 2: Associations & CRBAC Roles -->
        <div id="tab-roles" class="tab-content hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-8">
            <!-- Associations Selection -->
            <form method="POST" class="space-y-4">
                <input type="hidden" name="form_action" value="update_associations">
                <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Adhésion aux Associations Interne</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    {% for a in associations %}
                        {% set isMember = false %}
                        {% for memAssoc in membre.associations %}
                            {% if memAssoc.id == a.id %}{% set isMember = true %}{% endif %}
                        {% endfor %}
                        <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition">
                            <input type="checkbox" name="association_ids[]" value="{{ a.id }}" {% if isMember %}checked{% endif %} class="w-4 h-4 text-indigo-600 rounded border-slate-300">
                            <div>
                                <p class="text-xs font-bold text-slate-800">{{ a.nom }}</p>
                                <p class="text-[10px] text-slate-400">{{ a.fiangonana ? a.fiangonana.nom : '' }}</p>
                            </div>
                        </label>
                    {% endfor %}
                </div>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2 rounded-xl transition">Mettre à jour les Associations</button>
            </form>

            <!-- CRBAC Roles Assignment -->
            <div class="space-y-4">
                <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Mandats & Rôles Contextuels Attribués (CRBAC)</h4>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-400 border-b border-slate-200">
                            <tr>
                                <th class="py-3 px-4">Rôle</th>
                                <th class="py-3 px-4">Contexte</th>
                                <th class="py-3 px-4">Période du Mandat</th>
                                <th class="py-3 px-4">Exercice</th>
                                <th class="py-3 px-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for ra in membre.roleAssignments %}
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="py-3 px-4 font-bold text-indigo-700 uppercase font-mono text-xs">{{ ra.role ? ra.role.name : 'N/A' }}</td>
                                    <td class="py-3 px-4 text-xs">
                                        {% if ra.associationContext %}
                                            <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-medium"><i class="fa-solid fa-users mr-1"></i> Assoc: {{ ra.associationContext.nom }}</span>
                                        {% elseif ra.groupeContext %}
                                            <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-medium"><i class="fa-solid fa-map-location-dot mr-1"></i> Zone/Groupe: {{ ra.groupeContext.nom }}</span>
                                        {% elseif ra.fiangonanaContext %}
                                            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-medium"><i class="fa-solid fa-church mr-1"></i> Paroisse: {{ ra.fiangonanaContext.nom }}</span>
                                        {% else %}
                                            <span class="italic text-slate-400">Global</span>
                                        {% endif %}
                                    </td>
                                    <td class="py-3 px-4 text-xs">
                                        <div class="flex items-center space-x-1 font-mono text-slate-600">
                                            <span>{{ ra.startDate ? ra.startDate|date('d/m/Y') : 'Infini' }}</span>
                                            <span>&rarr;</span>
                                            <span>{{ ra.endDate ? ra.endDate|date('d/m/Y') : 'Infini' }}</span>
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 text-xs font-mono">{{ ra.exerciceYear }}</td>
                                    <td class="py-3 px-4 text-right">
                                        <form method="POST" action="/admin/role-assignments/{{ ra.id }}/delete" onsubmit="return confirm('Retirer ce rôle ?');">
                                            <button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-semibold"><i class="fa-solid fa-trash mr-1"></i> Retirer</button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="py-4 text-center text-slate-400 text-xs">Aucun rôle contextuel attribué à ce membre.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Form to Add Role -->
                <form method="POST" class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-4">
                    <input type="hidden" name="form_action" value="add_role">
                    <h5 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Attribuer un Nouveau Rôle Contextuel</h5>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Rôle *</label>
                            <select name="role_id" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                                <option value="">-- Choisir un rôle --</option>
                                {% for r in roles %}
                                    <option value="{{ r.id }}">{{ r.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Type de Contexte *</label>
                            <select id="context_type" name="context_type" onchange="updateContextSelectOptions()" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                                <option value="fiangonana">Église / Paroisse</option>
                                <option value="association">Association</option>
                                <option value="groupe">Groupe / Zone Géographique</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Entité de Contexte *</label>
                            <select id="context_id" name="context_id" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                                <!-- Populated dynamically by JS -->
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Date Début Mandat</label>
                            <input type="date" name="start_date" value="{{ 'now'|date('Y-m-d') }}" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Date Fin Mandat</label>
                            <input type="date" name="end_date" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Année d'Exercice</label>
                            <input type="text" name="exercice_year" value="{{ 'now'|date('Y') }}" placeholder="Ex: 2026" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-5 py-2.5 rounded-xl transition shadow-sm"><i class="fa-solid fa-plus mr-1"></i> Attribuer le Rôle</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- TAB 3: Presence History -->
        <div id="tab-presence" class="tab-content hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-4">
            <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Historique des Pointages de Présence</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-400 border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-6">ID & Date / Heure</th>
                            <th class="py-3.5 px-6">Événement / Activité</th>
                            <th class="py-3.5 px-6">Scanné Par</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for p in presences %}
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-4 px-6 text-xs">
                                    <span class="font-bold text-slate-800">#{{ p.id }}</span>
                                    <p class="text-slate-400 mt-0.5">{{ p.scannedAt|date('d/m/Y H:i:s') }}</p>
                                </td>
                                <td class="py-4 px-6">
                                    <span class="px-3 py-1 rounded-lg text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
                                        {{ p.activityName }}
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-xs text-slate-500">
                                    {% if p.scannedBy %}
                                        {{ p.scannedBy.prenom }} {{ p.scannedBy.nom }}
                                    {% else %}
                                        <span class="italic text-slate-400">Scan Autonome</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="py-8 text-center text-slate-400">Aucun pointage de présence enregistré pour ce membre.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: Cotisations & Dons -->
        <div id="tab-finances" class="tab-content hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-8 space-y-8">
            <!-- Suivi Annuel des Cotisations Mensuelles (4 Tranches) -->
            <div class="space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
                    <div>
                        <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Suivi des Cotisations Mensuelles (Année {{ year }})</h4>
                        <p class="text-xs text-slate-500">Cotisations payables par mois (jusqu'à 4 tranches par mois)</p>
                    </div>
                    <div class="flex items-center space-x-3 text-xs font-bold">
                        <span class="px-3 py-1 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200">{{ monthsPaidCount }}/12 mois réglés</span>
                        <span class="px-3 py-1 rounded-xl bg-indigo-50 text-indigo-700 border border-indigo-200">Total: {{ totalCotisationsYear|number_format(2, ',', ' ') }} Ar</span>
                    </div>
                </div>

                <!-- Months Matrix Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-600">
                        <thead class="bg-slate-50 font-semibold uppercase text-slate-400 border-b border-slate-200">
                            <tr>
                                <th class="py-2.5 px-3">Mois</th>
                                <th class="py-2.5 px-3 text-center">Tranche 1 (1/4)</th>
                                <th class="py-2.5 px-3 text-center">Tranche 2 (2/4)</th>
                                <th class="py-2.5 px-3 text-center">Tranche 3 (3/4)</th>
                                <th class="py-2.5 px-3 text-center">Tranche 4 (4/4)</th>
                                <th class="py-2.5 px-3 text-right">Total Mois</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 font-mono">
                            {% set moisNoms = ['', 'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'] %}
                            {% for mIdx, mData in monthsMatrix %}
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="py-3 px-3 font-sans font-bold text-slate-800">{{ moisNoms[mIdx] }}</td>
                                    {% for tIdx in 1..4 %}
                                        {% set item = mData.tranches[tIdx] %}
                                        <td class="py-3 px-3 text-center">
                                            {% if item %}
                                                <span class="px-2 py-1 rounded bg-emerald-100 text-emerald-800 font-bold border border-emerald-200 block" title="{{ item.paidAt }}">
                                                    {{ item.montant|number_format(0, ',', ' ') }} Ar
                                                </span>
                                            {% else %}
                                                <span class="text-slate-300 italic">-</span>
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                    <td class="py-3 px-3 text-right font-bold text-indigo-700">
                                        {{ mData.totalPaid|number_format(0, ',', ' ') }} Ar
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Form Saisie Manuelle Cotisation -->
                <form method="POST" action="/admin/membres/{{ membre.id }}/add-cotisation" class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-4">
                    <h5 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Saisir un Paiement de Cotisation</h5>

                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Mois *</label>
                            <select name="mois" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                                {% for mIdx in 1..12 %}
                                    <option value="{{ mIdx }}" {% if mIdx == 'now'|date('n') %}selected{% endif %}>{{ moisNoms[mIdx] }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Tranche (Paiement en 4 fois) *</label>
                            <select name="tranche" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                                <option value="1">1ère tranche (1/4)</option>
                                <option value="2">2ème tranche (2/4)</option>
                                <option value="3">3ème tranche (3/4)</option>
                                <option value="4">4ème tranche (4/4)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Montant Payé (Ar) *</label>
                            <input type="number" step="100" name="montant" required placeholder="Ex: 5000" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Entité Bénéficiaire *</label>
                            <select name="context_type" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                                <option value="fiangonana">Paroisse / Église</option>
                                <option value="association">Association</option>
                                <option value="groupe">Zone / Groupe</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex justify-between items-center pt-1">
                        <input type="hidden" name="annee" value="{{ year }}">
                        <span class="text-[11px] text-slate-400">Paiement saisi par l'utilisateur ayant droit.</span>
                        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-5 py-2.5 rounded-xl transition shadow-sm">
                            <i class="fa-solid fa-check mr-1"></i> Enregistrer la Cotisation
                        </button>
                    </div>
                </form>
            </div>

            <!-- Section Dons Libres -->
            <div class="space-y-4 pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Gestion des Dons Libres</h4>
                    <span class="px-3 py-1 rounded-xl bg-purple-50 text-purple-700 border border-purple-200 font-bold text-xs">Total Dons: {{ totalDons|number_format(2, ',', ' ') }} Ar</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-600">
                        <thead class="bg-slate-50 font-semibold uppercase text-slate-400 border-b border-slate-200">
                            <tr>
                                <th class="py-2.5 px-3">Date</th>
                                <th class="py-2.5 px-3">Libellé / Motif</th>
                                <th class="py-2.5 px-3 text-right">Montant</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for d in dons %}
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="py-2.5 px-3 font-mono text-slate-400">{{ d.paidAt|date('d/m/Y H:i') }}</td>
                                    <td class="py-2.5 px-3 font-bold text-slate-800">{{ d.libelle }}</td>
                                    <td class="py-2.5 px-3 text-right font-mono font-bold text-purple-700">{{ d.montant|number_format(2, ',', ' ') }} Ar</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="py-4 text-center text-slate-400">Aucun don libre enregistré pour ce membre.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Form Saisie Manuelle Don -->
                <form method="POST" action="/admin/membres/{{ membre.id }}/add-don" class="bg-purple-50/50 p-5 rounded-2xl border border-purple-100 space-y-4">
                    <h5 class="text-xs font-bold text-purple-900 uppercase tracking-wider">Enregistrer un Don Libre</h5>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Montant du Don (Ar) *</label>
                            <input type="number" step="500" name="montant" required placeholder="Ex: 20000" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Libellé / Motif *</label>
                            <input type="text" name="libelle" required placeholder="Ex: Don de remerciement, Projet travaux..." class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs bg-white">
                        </div>
                    </div>

                    <div class="flex justify-end pt-1">
                        <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold text-xs px-5 py-2.5 rounded-xl transition shadow-sm">
                            <i class="fa-solid fa-heart mr-1"></i> Enregistrer le Don
                        </button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

</div>

{% block javascripts %}
<script>
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.tab-link').forEach(el => {
            el.classList.remove('border-indigo-600', 'text-indigo-600');
            el.classList.add('border-transparent', 'text-slate-500');
        });

        document.getElementById(tabId).classList.remove('hidden');
        const btn = document.getElementById('tab-btn-' + tabId.replace('tab-', ''));
        if (btn) {
            btn.classList.remove('border-transparent', 'text-slate-500');
            btn.classList.add('border-indigo-600', 'text-indigo-600');
        }
    }

    const contextData = {
        fiangonana: [
            {% for f in fiangonanas %}
                { id: {{ f.id }}, nom: {{ f.nom|json_encode|raw }} },
            {% endfor %}
        ],
        association: [
            {% for a in associations %}
                { id: {{ a.id }}, nom: {{ a.nom|json_encode|raw }} },
            {% endfor %}
        ],
        groupe: [
            {% for g in groupes %}
                { id: {{ g.id }}, nom: {{ g.nom|json_encode|raw }} },
            {% endfor %}
        ]
    };

    function updateContextSelectOptions() {
        const typeSelect = document.getElementById('context_type');
        const idSelect = document.getElementById('context_id');
        if (!typeSelect || !idSelect) return;

        const selectedType = typeSelect.value;
        const items = contextData[selectedType] || [];

        idSelect.innerHTML = '';
        if (items.length === 0) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '-- Aucun choix disponible --';
            idSelect.appendChild(opt);
            return;
        }

        items.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item.id;
            opt.textContent = item.nom;
            idSelect.appendChild(opt);
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        updateContextSelectOptions();
    });
</script>
{% endblock %}
{% endblock %}
