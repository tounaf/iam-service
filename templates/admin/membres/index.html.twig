{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Membres - Administration Paroissiale{% endblock %}
{% block header_title %}Gestion des Membres{% endblock %}

{% block body %}
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <!-- Header with Actions -->
    <div class="p-6 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h3 class="text-base font-bold text-slate-800">Liste des Membres Inscrits</h3>
            <p class="text-xs text-slate-500 mt-0.5">Consultez, recherchez, modifiez et gérez les cartes membres officielles.</p>
        </div>
        <div class="flex items-center space-x-3">
            <a href="/admin/membres/nouveau" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm px-4 py-2.5 rounded-xl flex items-center space-x-2 transition shadow-sm">
                <i class="fa-solid fa-plus"></i>
                <span>Nouveau Membre</span>
            </a>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-slate-50/50 p-4 border-b border-slate-200">
        <form method="GET" action="{{ path('admin_membre_index') }}" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <!-- Search input -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    <i class="fa-solid fa-magnifying-glass text-xs"></i>
                </span>
                <input type="text" name="search" value="{{ filters.search }}" placeholder="Rechercher nom ou prénom..."
                    class="w-full pl-9 pr-3 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
            </div>

            <!-- Fiangonana filter -->
            <div>
                <select name="fiangonana" onchange="this.form.submit()" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
                    <option value="">-- Toutes les Paroisses --</option>
                    {% for f in fiangonanas %}
                        <option value="{{ f.id }}" {{ filters.fiangonana == f.id ? 'selected' : '' }}>{{ f.nom }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Groupe filter -->
            <div>
                <select name="groupe" onchange="this.form.submit()" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
                    <option value="">-- Tous les Groupes / Zones --</option>
                    {% for g in groupes %}
                        <option value="{{ g.id }}" {{ filters.groupe == g.id ? 'selected' : '' }}>{{ g.nom }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Association filter -->
            <div>
                <select name="association" onchange="this.form.submit()" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
                    <option value="">-- Toutes les Associations --</option>
                    {% for a in associations %}
                        <option value="{{ a.id }}" {{ filters.association == a.id ? 'selected' : '' }}>{{ a.nom }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Submit & Reset Buttons -->
            <div class="flex items-center space-x-2">
                <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white text-xs font-medium py-2 px-3 rounded-lg transition flex items-center justify-center space-x-1.5">
                    <i class="fa-solid fa-filter"></i>
                    <span>Filtrer</span>
                </button>
                {% if filters.search or filters.fiangonana or filters.groupe or filters.association %}
                    <a href="{{ path('admin_membre_index') }}" class="p-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs rounded-lg transition flex items-center justify-center" title="Réinitialiser les filtres">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-400 border-b border-slate-200">
                <tr>
                    <th class="py-3.5 px-6">ID & Nom</th>
                    <th class="py-3.5 px-6">Contact</th>
                    <th class="py-3.5 px-6">Zone / Groupe</th>
                    <th class="py-3.5 px-6">Paroisse</th>
                    <th class="py-3.5 px-6 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for m in membres %}
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="py-4 px-6">
                            <div class="flex items-center space-x-3">
                                <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 text-xs font-bold flex items-center justify-center">
                                    #{{ m.id }}
                                </span>
                                <div>
                                    <div class="flex items-center space-x-2">
                                        <p class="font-bold text-slate-800">{{ m.prenom }} {{ m.nom }}</p>
                                        {% if m.age is not null %}
                                            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-100">{{ m.age }} ans</span>
                                        {% endif %}
                                    </div>
                                    <p class="text-[11px] text-slate-400 font-mono">Token: {{ m.qrCodeToken|default('N/A') }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="py-4 px-6 text-xs">
                            <p class="font-medium text-slate-700">{{ m.email|default('Non renseigné') }}</p>
                            <p class="text-slate-400 mt-0.5">{{ m.telephone|default('Non renseigné') }}</p>
                        </td>
                        <td class="py-4 px-6 text-xs">
                            <span class="px-2.5 py-1 rounded-md font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                {{ m.zoneGeographique ? m.zoneGeographique.nom : 'Non spécifiée' }}
                            </span>
                        </td>
                        <td class="py-4 px-6 text-xs font-medium text-slate-700">
                            {{ m.fiangonana ? m.fiangonana.nom : 'Paroisse' }}
                        </td>
                        <td class="py-4 px-6 text-right space-x-2">
                            <!-- Carte Membre Printable -->
                            <a href="/api/membres/{{ m.id }}/carte" target="_blank" title="Imprimer Carte Membre" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition">
                                <i class="fa-solid fa-id-card"></i>
                            </a>
                            <!-- Stats Participation -->
                            <a href="/api/membres/{{ m.id }}/participation-stats" target="_blank" title="Statistiques de Présence" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-100 transition">
                                <i class="fa-solid fa-chart-line"></i>
                            </a>
                            <!-- Editer -->
                            <a href="/admin/membres/{{ m.id }}/editer" title="Éditer Membre" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100 transition">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <!-- Supprimer -->
                            <form method="POST" action="/admin/membres/{{ m.id }}/supprimer" class="inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ m.prenom|escape('js') }} {{ m.nom|escape('js') }} ? Cette action est irréversible.');">
                                <button type="submit" title="Supprimer le Membre" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="py-8 text-center text-slate-400">Aucun membre ne correspond à vos critères de recherche.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <div class="px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
        <div>
            {% if totalItems > 0 %}
                {% set startItem = (page - 1) * limit + 1 %}
                {% set endItem = page * limit < totalItems ? page * limit : totalItems %}
                Affichage de <span class="font-semibold text-slate-700">{{ startItem }}</span> à <span class="font-semibold text-slate-700">{{ endItem }}</span> sur <span class="font-semibold text-slate-700">{{ totalItems }}</span> membres
            {% else %}
                0 membres trouvés
            {% endif %}
        </div>

        {% if totalPages > 1 %}
            <div class="flex items-center space-x-1">
                <!-- Previous Button -->
                {% if page > 1 %}
                    <a href="{{ path('admin_membre_index', filters|merge({'page': page - 1})) }}" class="px-2.5 py-1.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 transition font-medium">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i> Précédent
                    </a>
                {% else %}
                    <span class="px-2.5 py-1.5 rounded bg-slate-50 text-slate-300 font-medium cursor-not-allowed">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i> Précédent
                    </span>
                {% endif %}

                <!-- Page numbers -->
                {% set minPage = max(1, page - 2) %}
                {% set maxPage = min(totalPages, page + 2) %}

                {% if minPage > 1 %}
                    <a href="{{ path('admin_membre_index', filters|merge({'page': 1})) }}" class="px-2.5 py-1.5 rounded hover:bg-slate-100 text-slate-700 transition font-medium">1</a>
                    {% if minPage > 2 %}
                        <span class="px-1.5 text-slate-400">...</span>
                    {% endif %}
                {% endif %}

                {% for p in minPage..maxPage %}
                    {% if p == page %}
                        <span class="px-2.5 py-1.5 rounded bg-indigo-600 text-white font-bold">{{ p }}</span>
                    {% else %}
                        <a href="{{ path('admin_membre_index', filters|merge({'page': p})) }}" class="px-2.5 py-1.5 rounded hover:bg-slate-100 text-slate-700 transition font-medium">{{ p }}</a>
                    {% endif %}
                {% endfor %}

                {% if maxPage < totalPages %}
                    {% if maxPage < totalPages - 1 %}
                        <span class="px-1.5 text-slate-400">...</span>
                    {% endif %}
                    <a href="{{ path('admin_membre_index', filters|merge({'page': totalPages})) }}" class="px-2.5 py-1.5 rounded hover:bg-slate-100 text-slate-700 transition font-medium">{{ totalPages }}</a>
                {% endif %}

                <!-- Next Button -->
                {% if page < totalPages %}
                    <a href="{{ path('admin_membre_index', filters|merge({'page': page + 1})) }}" class="px-2.5 py-1.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 transition font-medium">
                        Suivant <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                {% else %}
                    <span class="px-2.5 py-1.5 rounded bg-slate-50 text-slate-300 font-medium cursor-not-allowed">
                        Suivant <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </span>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
