<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ prenom }} {{ nom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #ccc;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche membre
        </button>
    </div>

    <!-- Member Fiche Container -->
    <div class="print-card bg-white w-full max-w-[720px] rounded-2xl shadow-2xl overflow-hidden border border-slate-200 flex flex-col relative">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-6 flex justify-between items-center">
            <div>
                <h2 class="text-xs font-semibold uppercase tracking-widest text-blue-200">Fiche Membre Officielle</h2>
                <h1 class="text-xl font-bold truncate max-w-[480px] mt-1">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <span class="bg-blue-500/30 text-white text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full border border-blue-400/30">
                    ID #{{ memberId }}
                </span>
            </div>
        </div>

        <!-- Content -->
        <div class="p-6 space-y-6">
            <!-- Top Identity Row -->
            <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6 pb-6 border-b border-slate-100">
                <div class="flex flex-col sm:flex-row items-center sm:items-start space-y-4 sm:space-y-0 sm:space-x-5 text-center sm:text-left">
                    <div class="w-24 h-24 rounded-2xl border-2 border-indigo-100 bg-indigo-50 overflow-hidden flex items-center justify-center shrink-0 shadow-sm">
                        {% if photoUrl is defined and photoUrl is not empty %}
                            <img src="{{ photoUrl }}" alt="{{ prenom }} {{ nom }}" class="w-full h-full object-cover" />
                        {% else %}
                            <span class="text-indigo-600 text-3xl font-extrabold">{{ prenom|first }}</span>
                        {% endif %}
                    </div>
                    <div>
                        <h2 class="text-2xl font-extrabold text-slate-800">{{ prenom }} {{ nom }}</h2>
                        <p class="text-xs text-slate-500 font-medium mt-1">Paroisse: <span class="text-slate-700 font-semibold">{{ fiangonanaNom }}</span></p>
                        {% if age is defined and age is not null %}
                            <span class="inline-block mt-2 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                {{ age }} ans
                            </span>
                        {% endif %}
                    </div>
                </div>

                <!-- QR Code Block -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-3 rounded-2xl border border-slate-200 shadow-inner shrink-0">
                    <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du Membre" />
                    <span class="text-[9px] uppercase tracking-widest text-slate-400 mt-1 font-bold">QR Code Présence</span>
                    {% if token is defined and token != 'N/A' %}
                        <span class="text-[8px] font-mono text-slate-400">Token: {{ token }}</span>
                    {% endif %}
                </div>
            </div>

            <!-- Details Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Personal Info -->
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2 text-xs">
                    <h3 class="text-xs font-extrabold uppercase tracking-wider text-indigo-700 pb-2 border-b border-slate-200">Coordonnées & État Civil</h3>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-400 font-medium">Email</span>
                        <span class="text-slate-700 font-semibold">{{ email|default('Non renseigné') }}</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-400 font-medium">Téléphone</span>
                        <span class="text-slate-700 font-semibold">{{ telephone|default('Non renseigné') }}</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-400 font-medium">Adresse</span>
                        <span class="text-slate-700 font-semibold">{{ adresse|default('Non renseignée') }}</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-slate-400 font-medium">Date de naissance</span>
                        <span class="text-slate-700 font-semibold">{{ dateNaissance|default('Non renseignée') }}</span>
                    </div>
                </div>

                <!-- Affiliations -->
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2 text-xs">
                    <h3 class="text-xs font-extrabold uppercase tracking-wider text-indigo-700 pb-2 border-b border-slate-200">Affiliations & Rapprochements</h3>
                    <div class="flex justify-between py-1 border-b border-slate-100">
                        <span class="text-slate-400 font-medium">Zone Geographique</span>
                        <span class="text-slate-700 font-semibold">{{ groupeNom|default('Non spécifié') }}</span>
                    </div>
                    <div class="py-1">
                        <span class="text-slate-400 font-medium block mb-1">Associations / Groupes</span>
                        <span class="text-slate-700 font-semibold block">{{ associationsStr|default('Aucune') }}</span>
                    </div>
                </div>
            </div>

            <!-- Attendance Stats Summary if available -->
            {% if stats is defined and stats is not null %}
                <div class="bg-emerald-50/70 p-4 rounded-xl border border-emerald-200 space-y-2 text-xs">
                    <h3 class="text-xs font-extrabold uppercase tracking-wider text-emerald-800 pb-2 border-b border-emerald-200">Assiduité & Assiduité Annuelle ({{ stats.year|default(year|default('Année')) }})</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center pt-1">
                        <div>
                            <span class="text-[10px] text-emerald-600 uppercase font-bold">Taux de présence</span>
                            <p class="text-lg font-extrabold text-emerald-800">{{ stats.participationRate }}%</p>
                        </div>
                        <div>
                            <span class="text-[10px] text-emerald-600 uppercase font-bold">Événements présent</span>
                            <p class="text-lg font-extrabold text-emerald-800">{{ stats.attendedActivitiesCount }} / {{ stats.totalActivitiesCount }}</p>
                        </div>
                        <div>
                            <span class="text-[10px] text-emerald-600 uppercase font-bold">Ponctualité</span>
                            <p class="text-lg font-extrabold text-emerald-800">{{ stats.onTimeCount }} à l'heure</p>
                        </div>
                        <div>
                            <span class="text-[10px] text-emerald-600 uppercase font-bold">Retards</span>
                            <p class="text-lg font-extrabold text-emerald-800">{{ stats.lateCount }} retard(s)</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-6 py-3 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-500">
            <span>Fiche Générée le {{ "now"|date("d/m/Y H:i") }}</span>
            <span class="font-medium">Gestion Paroissiale & Associations</span>
        </div>
    </div>

</body>
</html>
