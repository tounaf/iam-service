<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4 md:p-8">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche
        </button>
        <a href="/api/membres/{{ memberId }}/carte" target="_blank" class="bg-slate-800 hover:bg-slate-900 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            Voir la Carte Membre
        </a>
    </div>

    <!-- Official Member Sheet (Fiche Individuelle) -->
    <div class="print-card bg-white w-full max-w-3xl rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col relative transition duration-300">
        <!-- Header -->
        <div class="bg-gradient-to-r from-slate-900 via-indigo-900 to-slate-900 text-white p-6 flex justify-between items-center border-b border-indigo-700/50">
            <div>
                <h2 class="text-xs font-semibold uppercase tracking-widest text-indigo-300">Fiche Individuelle de Membre</h2>
                <h1 class="text-xl font-bold mt-1">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <span class="bg-indigo-500/30 text-indigo-200 text-xs font-mono font-bold tracking-wider px-3 py-1.5 rounded-lg border border-indigo-400/30">
                    ID: #{{ memberId }}
                </span>
            </div>
        </div>

        <!-- Body Section -->
        <div class="p-8 space-y-6">
            <!-- Top Summary Card with Avatar & QR Code -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-200/80">
                <!-- Profile Avatar / Photo -->
                <div class="flex flex-col items-center justify-center text-center">
                    {% if photoUrl %}
                        <img src="{{ photoUrl }}" alt="{{ nom }} {{ prenom }}" class="w-28 h-28 rounded-2xl object-cover shadow-md border-2 border-white" />
                    {% else %}
                        <div class="w-28 h-28 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-3xl border-2 border-white shadow-sm">
                            {{ prenom|slice(0, 1)|upper }}{{ nom|slice(0, 1)|upper }}
                        </div>
                    {% endif %}
                    <h3 class="text-lg font-bold text-slate-800 mt-3">{{ prenom }} {{ nom }}</h3>
                    <p class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mt-0.5">{{ groupeNom }}</p>
                </div>

                <!-- Info Details -->
                <div class="space-y-3 text-xs md:col-span-1 justify-center flex flex-col">
                    <div>
                        <span class="text-slate-400 font-semibold uppercase text-[10px] block">Email</span>
                        <span class="text-slate-800 font-medium">{{ email }}</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-semibold uppercase text-[10px] block">Téléphone</span>
                        <span class="text-slate-800 font-medium">{{ telephone }}</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-semibold uppercase text-[10px] block">Sexe / Genre</span>
                        <span class="text-slate-800 font-medium">{% if sexe == 'M' %}Masculin{% elseif sexe == 'F' %}Féminin{% else %}Non spécifié{% endif %}</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-semibold uppercase text-[10px] block">Date de naissance / Âge</span>
                        <span class="text-slate-800 font-medium">{{ dateNaissance ?? 'Non renseignée' }} {% if age is defined and age is not null %}({{ age }} ans){% endif %}</span>
                    </div>
                </div>

                <!-- QR Code for Presence Scanning -->
                <div class="flex flex-col items-center justify-center bg-white p-3 rounded-xl border border-slate-200 shadow-sm">
                    <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du Membre" />
                    <span class="text-[9px] uppercase tracking-wider text-slate-500 font-bold mt-2">Code QR d'Emargement</span>
                    <span class="text-[8px] font-mono text-slate-400 mt-0.5">Token: {{ token }}</span>
                </div>
            </div>

            <!-- Associations & Roles Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Associations -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center">
                        <svg class="w-4 h-4 mr-1.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        Associations Rattachées
                    </h4>
                    {% if associationsList is not empty %}
                        <div class="flex flex-wrap gap-1.5">
                            {% for assoc in associationsList %}
                                <span class="bg-indigo-50 text-indigo-700 text-xs px-2.5 py-1 rounded-lg font-medium border border-indigo-100">
                                    {{ assoc }}
                                </span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-xs text-slate-400 italic">Aucune association affiliée.</p>
                    {% endif %}
                </div>

                <!-- Roles -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center">
                        <svg class="w-4 h-4 mr-1.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        Responsabilités & Rôles
                    </h4>
                    {% if rolesList is not empty %}
                        <div class="space-y-1.5 text-xs">
                            {% for roleItem in rolesList %}
                                <div class="flex justify-between items-center bg-slate-50 p-2 rounded-lg border border-slate-100">
                                    <span class="font-bold text-slate-700">{{ roleItem.role }}</span>
                                    <span class="text-[10px] text-slate-500 font-medium">{{ roleItem.context }} {% if roleItem.exerciceYear %}({{ roleItem.exerciceYear }}){% endif %}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-xs text-slate-400 italic">Aucun rôle spécifique attribué.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Attendance / Participation Statistics Summary -->
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4 flex items-center justify-between">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-1.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Statistiques de Présence (Année {{ year }})
                    </span>
                    <span class="text-[10px] text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full font-bold border border-emerald-200">
                        Taux Global: {{ stats.participationRate ?? 0 }}%
                    </span>
                </h4>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <span class="text-lg font-extrabold text-slate-800">{{ stats.totalActivitiesCount ?? 0 }}</span>
                        <p class="text-[9px] uppercase font-semibold text-slate-400 mt-0.5">Activités Total</p>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <span class="text-lg font-extrabold text-emerald-600">{{ stats.attendedActivitiesCount ?? 0 }}</span>
                        <p class="text-[9px] uppercase font-semibold text-slate-400 mt-0.5">Présences</p>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <span class="text-lg font-extrabold text-indigo-600">{{ stats.onTimeCount ?? 0 }}</span>
                        <p class="text-[9px] uppercase font-semibold text-slate-400 mt-0.5">À l'heure</p>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <span class="text-lg font-extrabold text-amber-600">{{ stats.lateCount ?? 0 }}</span>
                        <p class="text-[9px] uppercase font-semibold text-slate-400 mt-0.5">En retard</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-4 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-500">
            <span>Fiche émise par l'application officielle de la Paroisse</span>
            <span class="font-medium">Document officiel • Confidentiel</span>
        </div>
    </div>

</body>
</html>
