<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #ccc;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche
        </button>
    </div>

    <!-- Member Profile Document / Fiche -->
    <div class="print-card bg-white w-full max-w-2xl rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col relative">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-6 flex justify-between items-center">
            <div>
                <h2 class="text-xs font-semibold uppercase tracking-widest text-blue-200">Fiche Individuelle du Membre</h2>
                <h1 class="text-xl font-bold mt-1">{{ fiangonanaNom }}</h1>
            </div>
            <span class="bg-blue-500/30 text-white text-xs uppercase font-bold tracking-wider px-3 py-1 rounded border border-blue-400/30">
                #{{ memberId }}
            </span>
        </div>

        <!-- Main Body -->
        <div class="p-8 space-y-6">
            <!-- Member Details & QR Code section -->
            <div class="flex flex-col sm:flex-row items-start justify-between gap-6 pb-6 border-b border-slate-200">
                <div class="flex items-center space-x-4">
                    {% if photo %}
                        <img src="/uploads/membres/{{ photo }}" alt="Photo de {{ nom }}" class="w-20 h-20 rounded-full object-cover border-2 border-indigo-600 shadow" />
                    {% else %}
                        <div class="w-20 h-20 rounded-full bg-indigo-100 text-indigo-700 font-bold text-2xl flex items-center justify-center border-2 border-indigo-200 shadow">
                            {{ prenom|slice(0, 1)|upper }}{{ nom|slice(0, 1)|upper }}
                        </div>
                    {% endif %}
                    <div>
                        <h3 class="text-2xl font-bold text-slate-900">{{ prenom }} {{ nom }}</h3>
                        <p class="text-sm font-medium text-slate-500 mt-0.5">{{ fiangonanaNom }}</p>
                    </div>
                </div>

                <!-- QR Code Block -->
                <div class="flex flex-col items-center bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du Membre" />
                    <span class="text-[9px] uppercase tracking-wider text-slate-500 font-bold mt-1">Badge de Présence</span>
                </div>
            </div>

            <!-- Profile Info Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <div class="bg-slate-50 p-3.5 rounded-lg border border-slate-100">
                    <p class="text-xs uppercase font-semibold text-slate-400">Zone / Groupe</p>
                    <p class="font-semibold text-slate-800 mt-1">{{ groupeNom }}</p>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-lg border border-slate-100">
                    <p class="text-xs uppercase font-semibold text-slate-400">Associations</p>
                    <p class="font-semibold text-slate-800 mt-1">{{ associationsStr }}</p>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-lg border border-slate-100">
                    <p class="text-xs uppercase font-semibold text-slate-400">Téléphone</p>
                    <p class="font-semibold text-slate-800 mt-1">{{ telephone }}</p>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-lg border border-slate-100">
                    <p class="text-xs uppercase font-semibold text-slate-400">Email</p>
                    <p class="font-semibold text-slate-800 mt-1">{{ email }}</p>
                </div>
            </div>

            <!-- Participation & Attendance Summary -->
            {% if stats is defined and stats %}
            <div class="space-y-3 pt-2">
                <div class="flex justify-between items-center border-b pb-2">
                    <h4 class="text-base font-bold text-slate-800">Statistiques de Présence ({{ year }})</h4>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
                        Taux de participation: {{ stats.participationRate }}%
                    </span>
                </div>

                <div class="grid grid-cols-3 gap-4 text-center">
                    <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-100">
                        <p class="text-2xl font-bold text-emerald-700">{{ stats.attendedActivitiesCount }}</p>
                        <p class="text-xs font-semibold text-emerald-800">Activités Présentes</p>
                    </div>
                    <div class="bg-blue-50 p-3 rounded-lg border border-blue-100">
                        <p class="text-2xl font-bold text-blue-700">{{ stats.onTimeCount }}</p>
                        <p class="text-xs font-semibold text-blue-800">A l'Heure ({{ stats.onTimeRate }}%)</p>
                    </div>
                    <div class="bg-amber-50 p-3 rounded-lg border border-amber-100">
                        <p class="text-2xl font-bold text-amber-700">{{ stats.lateCount }}</p>
                        <p class="text-xs font-semibold text-amber-800">En Retard ({{ stats.lateRate }}%)</p>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-3 border-t border-slate-200 flex justify-between items-center text-xs text-slate-500">
            <span>Code QR Token: {{ token }}</span>
            <span>Document généré automatiquement</span>
        </div>
    </div>

</body>
</html>
