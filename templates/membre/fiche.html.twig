<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #ccc;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche
        </button>
    </div>

    <!-- Main Member Fiche Document -->
    <div class="print-card bg-white w-full max-w-[700px] rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col relative">
        <!-- Top Header -->
        <div class="bg-gradient-to-r from-slate-800 to-indigo-900 text-white p-6 flex justify-between items-center">
            <div>
                <h2 class="text-xs font-semibold uppercase tracking-widest text-indigo-300">Fiche Individuelle de Membre</h2>
                <h1 class="text-xl font-bold mt-1">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <span class="bg-indigo-500/30 text-white text-xs uppercase font-bold tracking-wider px-3 py-1.5 rounded border border-indigo-400/30">
                    ID #{{ memberId }}
                </span>
            </div>
        </div>

        <div class="p-8 space-y-6">
            <!-- Section 1: Member Identity & QR Code -->
            <div class="flex flex-col sm:flex-row items-start justify-between gap-6 pb-6 border-b border-slate-200">
                <div class="flex items-start gap-4">
                    {% if photoUrl %}
                        <img src="{{ photoUrl }}" alt="{{ nom }} {{ prenom }}" class="w-20 h-20 rounded-full object-cover border-2 border-indigo-600 shadow" />
                    {% else %}
                        <div class="w-20 h-20 rounded-full bg-indigo-100 text-indigo-700 font-bold text-2xl flex items-center justify-center border-2 border-indigo-300">
                            {{ prenom|slice(0, 1)|upper }}{{ nom|slice(0, 1)|upper }}
                        </div>
                    {% endif %}
                    <div class="space-y-1">
                        <h2 class="text-2xl font-bold text-slate-800">{{ nom }} {{ prenom }}</h2>
                        <p class="text-xs text-slate-500">Membre Paroissial Enregistré</p>
                        <div class="pt-2 text-xs text-slate-600 space-y-0.5">
                            <p><span class="font-medium text-slate-500">Email:</span> {{ email }}</p>
                            <p><span class="font-medium text-slate-500">Téléphone:</span> {{ telephone }}</p>
                            <p><span class="font-medium text-slate-500">Adresse:</span> {{ adresse }}</p>
                            <p><span class="font-medium text-slate-500">Date de naissance:</span> {{ dateNaissance }}</p>
                        </div>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-3 rounded-xl border border-slate-200 self-center sm:self-start">
                    <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du Membre" />
                    <span class="text-[9px] uppercase tracking-wider text-slate-500 mt-1 font-bold">Code QR de Présence</span>
                </div>
            </div>

            <!-- Section 2: Affiliations -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-6 border-b border-slate-200 text-xs">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <p class="text-[10px] uppercase font-bold text-indigo-600 tracking-wider mb-1">Rattachement Territorial</p>
                    <p class="text-sm font-semibold text-slate-800">{{ fiangonanaNom }}</p>
                    <p class="text-slate-600 mt-1"><span class="font-medium">Zone / Groupe:</span> {{ groupeNom }}</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <p class="text-[10px] uppercase font-bold text-indigo-600 tracking-wider mb-1">Associations & Mouvements</p>
                    <p class="text-sm font-semibold text-slate-800">{{ associationsStr }}</p>
                </div>
            </div>

            <!-- Section 3: Attendance Statistics Summary -->
            {% if stats is defined and stats %}
                <div>
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Statistiques de Participation (Année {{ stats.year }})</h3>
                        <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full border border-indigo-200">
                            Taux: {{ stats.participationRate }}%
                        </span>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-xs">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <p class="text-[10px] uppercase font-semibold text-slate-400">Activités Totales</p>
                            <p class="text-lg font-bold text-slate-800 mt-0.5">{{ stats.totalActivitiesCount }}</p>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <p class="text-[10px] uppercase font-semibold text-slate-400">Présences</p>
                            <p class="text-lg font-bold text-emerald-600 mt-0.5">{{ stats.attendedActivitiesCount }}</p>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <p class="text-[10px] uppercase font-semibold text-slate-400">À l'Heure</p>
                            <p class="text-lg font-bold text-blue-600 mt-0.5">{{ stats.onTimeCount }}</p>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <p class="text-[10px] uppercase font-semibold text-slate-400">Retards</p>
                            <p class="text-lg font-bold text-amber-600 mt-0.5">{{ stats.lateCount }}</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
            <span>Jeton QR: {{ token }}</span>
            <span>Généré le {{ "now"|date("d/m/Y H:i") }}</span>
        </div>
    </div>

</body>
</html>
