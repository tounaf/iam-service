<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #ccc;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-start p-4 md:p-8">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche
        </button>
    </div>

    <!-- Member Fiche Container -->
    <div class="print-card bg-white w-full max-w-4xl rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col">
        <!-- Top Header -->
        <div class="bg-gradient-to-r from-blue-800 via-indigo-800 to-purple-800 text-white p-6 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
            <div>
                <h2 class="text-xs font-semibold uppercase tracking-widest text-blue-200">Fiche Individuelle du Membre</h2>
                <h1 class="text-2xl font-bold">{{ fiangonanaNom }}</h1>
            </div>
            <div class="flex items-center space-x-2">
                <span class="bg-white/20 text-white text-xs uppercase font-bold tracking-wider px-3 py-1.5 rounded-full border border-white/30">
                    Membre #{{ memberId }}
                </span>
            </div>
        </div>

        <!-- Main Body Grid -->
        <div class="p-6 md:p-8 space-y-8">
            <!-- Profile & Identity Section -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center bg-slate-50 p-6 rounded-xl border border-slate-200">
                <!-- Avatar / Photo -->
                <div class="flex flex-col items-center justify-center">
                    {% if photoUrl %}
                        <img src="{{ photoUrl }}" alt="{{ nom }} {{ prenom }}" class="w-28 h-28 rounded-full object-cover border-4 border-indigo-600 shadow-md">
                    {% else %}
                        <div class="w-28 h-28 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-3xl font-bold border-4 border-indigo-600 shadow-md">
                            {{ prenom|slice(0, 1)|upper }}{{ nom|slice(0, 1)|upper }}
                        </div>
                    {% endif %}
                    <span class="mt-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Identité Officielle</span>
                </div>

                <!-- Info Columns -->
                <div class="md:col-span-2 space-y-3">
                    <div>
                        <h3 class="text-2xl font-bold text-slate-800">{{ nom }} {{ prenom }}</h3>
                        <p class="text-sm text-slate-500 font-medium">Sexe: {{ sexe }}</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                        <div>
                            <span class="block text-xs uppercase text-slate-400 font-semibold">Téléphone</span>
                            <span class="font-semibold text-slate-700">{{ telephone }}</span>
                        </div>
                        <div>
                            <span class="block text-xs uppercase text-slate-400 font-semibold">Email</span>
                            <span class="font-semibold text-slate-700 truncate block">{{ email }}</span>
                        </div>
                        <div class="sm:col-span-2">
                            <span class="block text-xs uppercase text-slate-400 font-semibold">Adresse</span>
                            <span class="font-semibold text-slate-700">{{ adresse }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Affiliations & QR Code Section -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Affiliations Info -->
                <div class="md:col-span-2 bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-4">
                    <h4 class="text-xs uppercase font-bold text-indigo-700 tracking-wider">Rattachements & Structures</h4>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                        <div class="bg-white p-3 rounded-lg border border-slate-200">
                            <span class="block text-xs text-slate-400 font-medium">Paroisse / Fiangonana</span>
                            <span class="font-bold text-slate-800">{{ fiangonanaNom }}</span>
                        </div>
                        <div class="bg-white p-3 rounded-lg border border-slate-200">
                            <span class="block text-xs text-slate-400 font-medium">Zone Géographique / Groupe</span>
                            <span class="font-bold text-slate-800">{{ groupeNom }}</span>
                        </div>
                        <div class="sm:col-span-2 bg-white p-3 rounded-lg border border-slate-200">
                            <span class="block text-xs text-slate-400 font-medium">Associations Rattachées</span>
                            <span class="font-bold text-indigo-900">{{ associationsStr }}</span>
                        </div>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 flex flex-col items-center justify-center text-center">
                    <img src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code" class="w-32 h-32 mix-blend-multiply rounded-lg">
                    <span class="text-xs font-bold text-slate-700 mt-2">Scan Présence</span>
                    <span class="text-[10px] text-slate-400 font-mono mt-0.5">Token: {{ token }}</span>
                </div>
            </div>

            <!-- Participation Statistics Section -->
            {% if participationStats is defined and participationStats %}
            <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-4">
                <div class="flex justify-between items-center border-b border-slate-200 pb-3">
                    <h4 class="text-xs uppercase font-bold text-indigo-700 tracking-wider">Statistiques de Participation (Année {{ year }})</h4>
                    <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full">
                        Taux: {{ participationStats.participationRate|default(0) }}%
                    </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-2xl font-bold text-slate-800">{{ participationStats.totalActivitiesCount|default(0) }}</span>
                        <span class="block text-xs text-slate-500 font-medium mt-1">Activités Totales</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-2xl font-bold text-emerald-600">{{ participationStats.attendedActivitiesCount|default(0) }}</span>
                        <span class="block text-xs text-slate-500 font-medium mt-1">Présences Enregistrées</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-2xl font-bold text-blue-600">{{ participationStats.onTimeCount|default(0) }}</span>
                        <span class="block text-xs text-slate-500 font-medium mt-1">A L'Heure</span>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-2xl font-bold text-amber-600">{{ participationStats.lateCount|default(0) }}</span>
                        <span class="block text-xs text-slate-500 font-medium mt-1">Retards</span>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="bg-slate-100 px-6 py-4 border-t border-slate-200 flex justify-between items-center text-xs text-slate-500">
            <span>Fiche membre générée le {{ "now"|date("d/m/Y") }}</span>
            <span class="font-medium">Direction & Secrétariat</span>
        </div>
    </div>

</body>
</html>
