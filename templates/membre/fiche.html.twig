<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-sheet {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-start p-6">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center text-sm">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche membre
        </button>
    </div>

    <!-- Official Member Fiche Sheet -->
    <div class="print-sheet bg-white w-full max-w-3xl rounded-3xl shadow-xl overflow-hidden border border-slate-200 flex flex-col">
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-blue-800 via-indigo-800 to-indigo-900 text-white p-6 flex justify-between items-center">
            <div>
                <span class="bg-blue-500/30 text-blue-200 text-[10px] uppercase font-extrabold tracking-widest px-2.5 py-1 rounded-md border border-blue-400/30">
                    Fiche Individuelle de Membre
                </span>
                <h1 class="text-2xl font-black mt-1">{{ fiangonanaNom }}</h1>
                <p class="text-xs text-blue-200 font-medium mt-0.5">ID Membre: #{{ memberId }} • Année d'analyse: {{ year }}</p>
            </div>
            <div class="bg-white/10 p-3 rounded-2xl border border-white/20 backdrop-blur-sm text-center">
                <span class="text-3xl font-black block">{{ stats.participationRate }}%</span>
                <span class="text-[9px] uppercase font-bold text-blue-200 tracking-wider">Taux de Présence</span>
            </div>
        </div>

        <!-- Fiche Body Grid -->
        <div class="p-8 space-y-8">
            <!-- Row 1: Personal Info & QR Code -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                <div class="md:col-span-2 space-y-4">
                    <h2 class="text-xs font-black uppercase tracking-wider text-indigo-600 pb-1 border-b border-indigo-100 flex items-center">
                        Identité & Rattachement
                    </h2>
                    <div class="grid grid-cols-2 gap-4 text-xs">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Nom & Prénom</p>
                            <p class="text-base font-extrabold text-slate-800">{{ prenom }} {{ nom }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Date de Naissance</p>
                            <p class="text-sm font-semibold text-slate-700">{{ dateNaissance }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Paroisse (Fiangonana)</p>
                            <p class="text-sm font-semibold text-slate-700">{{ fiangonanaNom }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Groupe / Zone</p>
                            <p class="text-sm font-semibold text-slate-700">{{ groupeNom }}</p>
                        </div>
                        <div class="col-span-2">
                            <p class="text-[10px] uppercase font-bold text-slate-400">Associations & Sampana</p>
                            <p class="text-sm font-semibold text-slate-700">{{ associationsStr }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Email</p>
                            <p class="text-sm font-semibold text-slate-700">{{ email }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Téléphone</p>
                            <p class="text-sm font-semibold text-slate-700">{{ telephone }}</p>
                        </div>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-4 rounded-2xl border border-slate-200 text-center space-y-2">
                    <img class="w-36 h-36 object-contain mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code" />
                    <div>
                        <p class="text-[9px] uppercase font-extrabold tracking-wider text-slate-500">QR Code Présence</p>
                        <p class="text-[10px] font-mono text-slate-400 truncate max-w-[150px] mt-0.5">Token: {{ token }}</p>
                    </div>
                </div>
            </div>

            <!-- Row 2: Participation Statistics -->
            <div class="space-y-4">
                <h2 class="text-xs font-black uppercase tracking-wider text-indigo-600 pb-1 border-b border-indigo-100">
                    Bilan de Participation Annuel ({{ year }})
                </h2>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 text-center">
                        <span class="text-2xl font-black text-slate-800 block">{{ stats.totalActivitiesCount }}</span>
                        <span class="text-[10px] font-bold uppercase text-slate-400">Événements Totaux</span>
                    </div>
                    <div class="p-4 bg-indigo-50 rounded-2xl border border-indigo-100 text-center">
                        <span class="text-2xl font-black text-indigo-700 block">{{ stats.attendedActivitiesCount }}</span>
                        <span class="text-[10px] font-bold uppercase text-indigo-500">Activités Assistées</span>
                    </div>
                    <div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-100 text-center">
                        <span class="text-2xl font-black text-emerald-700 block">{{ stats.onTimeCount }}</span>
                        <span class="text-[10px] font-bold uppercase text-emerald-600">À l'Heure ({{ stats.onTimeRate }}%)</span>
                    </div>
                    <div class="p-4 bg-amber-50 rounded-2xl border border-amber-100 text-center">
                        <span class="text-2xl font-black text-amber-700 block">{{ stats.lateCount }}</span>
                        <span class="text-[10px] font-bold uppercase text-amber-600">En Retard ({{ stats.lateRate }}%)</span>
                    </div>
                </div>
            </div>

            <!-- Row 3: Recent Activity Logs -->
            {% if stats.presenceLogs is defined and stats.presenceLogs is not empty %}
            <div class="space-y-3">
                <h2 class="text-xs font-black uppercase tracking-wider text-indigo-600 pb-1 border-b border-indigo-100">
                    Historique Récent des Pointages (Scan)
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-400 text-[10px] uppercase font-extrabold border-b border-slate-200">
                                <th class="p-2.5">Activité / Événement</th>
                                <th class="p-2.5">Date & Heure de Scan</th>
                                <th class="p-2.5">Statut Ponctualité</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for log in stats.presenceLogs|slice(0, 5) %}
                            <tr class="hover:bg-slate-50/50">
                                <td class="p-2.5 font-bold text-slate-800">{{ log.activityName }}</td>
                                <td class="p-2.5 text-slate-600">{{ log.scannedAt|date("d/m/Y H:i") }}</td>
                                <td class="p-2.5">
                                    {% if log.isLate %}
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                            En retard (+{{ log.delayMinutes }}m)
                                        </span>
                                    {% else %}
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                            À l'heure
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
            <span>Fiche générée automatiquement le {{ "now"|date("d/m/Y à H:i") }}</span>
            <span class="font-bold text-slate-700">Direction & Secrétariat General</span>
        </div>
    </div>

</body>
</html>
