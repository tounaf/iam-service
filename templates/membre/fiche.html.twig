<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ prenom }} {{ nom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-start p-4 sm:p-8">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4 w-full max-w-4xl justify-between items-center">
        <a href="/espace-membre" class="text-xs font-bold text-slate-600 hover:text-slate-800 flex items-center bg-white px-4 py-2 rounded-lg shadow-sm border border-slate-200">
            &larr; Retour à l'espace membre
        </a>
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center text-xs">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche
        </button>
    </div>

    <!-- Main Fiche Container -->
    <div class="print-card bg-white w-full max-w-4xl rounded-3xl shadow-xl overflow-hidden border border-slate-200 flex flex-col">
        <!-- Top Gradient Header Bar -->
        <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-purple-800 text-white p-6 flex justify-between items-center">
            <div>
                <span class="bg-white/20 text-white text-[10px] uppercase font-bold tracking-widest px-2.5 py-1 rounded-md border border-white/30 inline-block mb-1">
                    Fiche Membre Officielle
                </span>
                <h1 class="text-xl font-extrabold tracking-tight">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <p class="text-xs font-mono opacity-80">ID: #{{ memberId }}</p>
                <p class="text-[10px] opacity-75">Année d'exercice: {{ year }}</p>
            </div>
        </div>

        <!-- Identity & Affiliations Overview -->
        <div class="p-6 md:p-8 space-y-6">
            <div class="flex flex-col md:flex-row items-center md:items-start gap-6 border-b border-slate-100 pb-6">
                <!-- Avatar / Photo -->
                <div class="w-32 h-32 rounded-2xl border-4 border-slate-100 shadow-md overflow-hidden bg-slate-50 shrink-0 flex items-center justify-center">
                    {% if photoUrl %}
                        <img src="{{ photoUrl }}" alt="{{ prenom }} {{ nom }}" class="w-full h-full object-cover" />
                    {% else %}
                        <div class="w-full h-full bg-indigo-100 text-indigo-700 font-extrabold text-4xl flex items-center justify-center">
                            {{ prenom ? prenom|slice(0, 1)|upper : 'M' }}
                        </div>
                    {% endif %}
                </div>

                <!-- Info Grid -->
                <div class="flex-1 space-y-3 w-full text-center md:text-left">
                    <div>
                        <h2 class="text-2xl font-black text-slate-800">{{ prenom }} {{ nom }}</h2>
                        <p class="text-xs text-slate-500 font-semibold mt-0.5">
                            {% if sexe %}<span class="inline-block mr-2 font-bold text-slate-700">Sexe: {{ sexe == 'M' ? 'Masculin' : (sexe == 'F' ? 'Féminin' : sexe) }}</span>{% endif %}
                            {% if age is not null %}<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">{{ age }} ans</span>{% endif %}
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-1">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Email</p>
                            <p class="text-slate-700 font-medium">{{ email ? email : 'Non renseigné' }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Téléphone</p>
                            <p class="text-slate-700 font-medium">{{ telephone }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Date de Naissance</p>
                            <p class="text-slate-700 font-medium">{{ dateNaissance ? dateNaissance : 'Non renseignée' }}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400">Adresse</p>
                            <p class="text-slate-700 font-medium">{{ adresse ? adresse : 'Non renseignée' }}</p>
                        </div>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-3 rounded-2xl border border-slate-200 shadow-inner shrink-0">
                    <img class="w-28 h-28 mix-blend-multiply object-contain" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code Présence" />
                    <span class="text-[8px] uppercase tracking-wider text-slate-400 mt-2 font-bold">Scanner pour présence</span>
                    <span class="text-[9px] font-mono text-slate-500 mt-0.5">Token: {{ token }}</span>
                </div>
            </div>

            <!-- Affiliations & Roles -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Entity Affiliations -->
                <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200/80 space-y-3">
                    <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 flex items-center">
                        <svg class="w-4 h-4 mr-1.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h5m-5 0V12m0 0h-2m2 0h2"></path></svg>
                        Rattachements Organisationnels
                    </h3>
                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between py-1 border-b border-slate-200/60">
                            <span class="text-slate-500">Paroisse / Fiangonana:</span>
                            <span class="font-bold text-slate-800">{{ fiangonanaNom }}</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-200/60">
                            <span class="text-slate-500">Zone / Groupe:</span>
                            <span class="font-bold text-slate-800">{{ groupeNom }}</span>
                        </div>
                        <div class="flex justify-between py-1">
                            <span class="text-slate-500">Associations:</span>
                            <span class="font-bold text-slate-800 text-right">{{ associationsStr }}</span>
                        </div>
                    </div>
                </div>

                <!-- Roles assigned -->
                <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200/80 space-y-3">
                    <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 flex items-center">
                        <svg class="w-4 h-4 mr-1.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                        Responsabilités & Rôles
                    </h3>
                    {% if roles is not empty %}
                        <div class="space-y-2 text-xs">
                            {% for r in roles %}
                                <div class="flex justify-between items-center py-1 border-b border-slate-200/60 last:border-0">
                                    <span class="font-bold text-slate-800">{{ r.role }}</span>
                                    <span class="text-slate-500 text-[11px]">{{ r.context }} {% if r.exerciceYear %}({{ r.exerciceYear }}){% endif %}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-xs text-slate-400 italic">Aucun rôle spécifique attribué.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Participation & Attendance Summary Section -->
            <div class="space-y-4 pt-2">
                <div class="flex justify-between items-center">
                    <h3 class="text-sm font-black uppercase tracking-wider text-slate-800 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Statistiques d'Assiduité & Taux de Participation (Année {{ year }})
                    </h3>
                </div>

                <!-- KPI Cards Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4 text-center">
                        <p class="text-[10px] uppercase font-bold text-indigo-500">Taux Global</p>
                        <p class="text-2xl font-black text-indigo-700 mt-1">{{ stats.participationRate }}%</p>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 text-center">
                        <p class="text-[10px] uppercase font-bold text-emerald-500">Activités Présentes</p>
                        <p class="text-2xl font-black text-emerald-700 mt-1">{{ stats.attendedActivitiesCount }} / {{ stats.totalActivitiesCount }}</p>
                    </div>
                    <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 text-center">
                        <p class="text-[10px] uppercase font-bold text-amber-500">Retards</p>
                        <p class="text-2xl font-black text-amber-700 mt-1">{{ stats.lateCount }}</p>
                    </div>
                    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 text-center">
                        <p class="text-[10px] uppercase font-bold text-blue-500">À L'Heure</p>
                        <p class="text-2xl font-black text-blue-700 mt-1">{{ stats.onTimeCount }}</p>
                    </div>
                </div>

                <!-- Entity Breakdown Stats -->
                {% if stats.entityStats is defined %}
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
                        {% if stats.entityStats.associations is defined and stats.entityStats.associations is not empty %}
                            {% for aStat in stats.entityStats.associations %}
                                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs space-y-1">
                                    <p class="font-bold text-slate-800 text-ellipsis overflow-hidden whitespace-nowrap">Assoc: {{ aStat.nom }}</p>
                                    <div class="flex justify-between text-slate-600 pt-1">
                                        <span>Événements: <strong>{{ aStat.totalEvents }}</strong></span>
                                        <span>Taux: <strong class="text-indigo-600">{{ aStat.presenceRate }}%</strong></span>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}

                        {% if stats.entityStats.groupe is defined and stats.entityStats.groupe is not null %}
                            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs space-y-1">
                                <p class="font-bold text-slate-800 text-ellipsis overflow-hidden whitespace-nowrap">Zone: {{ stats.entityStats.groupe.nom }}</p>
                                <div class="flex justify-between text-slate-600 pt-1">
                                    <span>Événements: <strong>{{ stats.entityStats.groupe.totalEvents }}</strong></span>
                                    <span>Taux: <strong class="text-indigo-600">{{ stats.entityStats.groupe.presenceRate }}%</strong></span>
                                </div>
                            </div>
                        {% endif %}

                        {% if stats.entityStats.fiangonana is defined and stats.entityStats.fiangonana is not null %}
                            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs space-y-1">
                                <p class="font-bold text-slate-800 text-ellipsis overflow-hidden whitespace-nowrap">Paroisse: {{ stats.entityStats.fiangonana.nom }}</p>
                                <div class="flex justify-between text-slate-600 pt-1">
                                    <span>Événements: <strong>{{ stats.entityStats.fiangonana.totalEvents }}</strong></span>
                                    <span>Taux: <strong class="text-indigo-600">{{ stats.entityStats.fiangonana.presenceRate }}%</strong></span>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                <!-- Presence Logs Table -->
                {% if stats.presenceLogs is defined and stats.presenceLogs is not empty %}
                    <div class="pt-2">
                        <p class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Historique des Présences Scannées ({{ stats.presenceLogs|length }})</p>
                        <div class="overflow-x-auto rounded-xl border border-slate-200">
                            <table class="w-full text-left text-xs text-slate-700">
                                <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500 border-b border-slate-200">
                                    <tr>
                                        <th class="px-4 py-2.5">Activité / Événement</th>
                                        <th class="px-4 py-2.5">Date & Heure du Scan</th>
                                        <th class="px-4 py-2.5">Statut Ponctualité</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 bg-white">
                                    {% for log in stats.presenceLogs|slice(0, 10) %}
                                        <tr class="hover:bg-slate-50">
                                            <td class="px-4 py-2.5 font-semibold text-slate-800">{{ log.activityName }}</td>
                                            <td class="px-4 py-2.5 text-slate-500">{{ log.scannedAt|date("d/m/Y H:i") }}</td>
                                            <td class="px-4 py-2.5">
                                                {% if log.isLate %}
                                                    <span class="bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded text-[10px]">Retard ({{ log.delayMinutes }} min)</span>
                                                {% else %}
                                                    <span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded text-[10px]">À l'heure</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Card Footer -->
        <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-2">
            <span>Fiche générée automatiquement pour le membre #{{ memberId }}</span>
            <span class="font-medium">URL de Scan Direct: <code class="bg-slate-200 px-2 py-0.5 rounded font-mono text-[10px] text-slate-700">{{ scanUrl }}</code></span>
        </div>
    </div>

</body>
</html>
