<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre Officielle - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-container {
                box-shadow: none;
                border: none;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen p-4 md:p-8 flex flex-col items-center">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 w-full max-w-4xl flex justify-between items-center">
        <a href="/admin/membres" class="text-slate-600 hover:text-slate-900 text-sm font-semibold flex items-center">
            &larr; Retour à la liste
        </a>
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la Fiche Membre
        </button>
    </div>

    <!-- Official Member Sheet Document -->
    <div class="print-container bg-white w-full max-w-4xl rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <!-- Sheet Header -->
        <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-blue-900 text-white p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center border-b border-indigo-900">
            <div class="flex items-center space-x-5">
                {% if photoUrl %}
                    <img src="{{ photoUrl }}" alt="{{ prenom }} {{ nom }}" class="w-20 h-20 rounded-2xl object-cover border-2 border-indigo-400/40 shadow-md">
                {% else %}
                    <div class="w-20 h-20 rounded-2xl bg-indigo-800 border-2 border-indigo-400/40 flex items-center justify-center text-white text-2xl font-bold uppercase shadow-md">
                        {{ prenom|slice(0, 1) }}{{ nom|slice(0, 1) }}
                    </div>
                {% endif %}
                <div>
                    <span class="text-xs font-semibold text-indigo-300 uppercase tracking-widest">Fiche Individuelle de Membre</span>
                    <h1 class="text-2xl md:text-3xl font-extrabold text-white mt-0.5">{{ nom }} {{ prenom }}</h1>
                    <p class="text-sm text-indigo-200 font-medium mt-1">{{ fiangonanaNom }} &bull; {{ groupeNom }}</p>
                </div>
            </div>
            <div class="mt-4 md:mt-0 text-right">
                <span class="bg-indigo-500/20 text-indigo-200 border border-indigo-400/30 text-xs font-mono font-semibold px-3 py-1 rounded-full inline-block">
                    ID: #{{ memberId }}
                </span>
                <p class="text-[11px] text-slate-300 font-mono mt-1">Token QR: {{ token }}</p>
            </div>
        </div>

        <!-- Content Grid -->
        <div class="p-6 md:p-8 space-y-8">

            <!-- Section 1: Informations Personnelles & Affiliations -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Personal Data -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 pb-2 border-b border-slate-200 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Informations Personnelles
                    </h3>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <span class="text-slate-400 font-medium block">Sexe</span>
                            <span class="text-slate-800 font-semibold">{{ sexe == 'M' ? 'Masculin' : (sexe == 'F' ? 'Féminin' : sexe) }}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 font-medium block">Date de Naissance</span>
                            <span class="text-slate-800 font-semibold">{{ dateNaissance }} {% if age %}({{ age }} ans){% endif %}</span>
                        </div>
                        <div class="col-span-2">
                            <span class="text-slate-400 font-medium block">Email</span>
                            <span class="text-slate-800 font-semibold truncate block">{{ email }}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 font-medium block">Téléphone</span>
                            <span class="text-slate-800 font-semibold">{{ telephone }}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 font-medium block">Adresse</span>
                            <span class="text-slate-800 font-semibold">{{ adresse }}</span>
                        </div>
                    </div>
                </div>

                <!-- Affiliations & Roles -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 pb-2 border-b border-slate-200 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        Rattachements & Mandats
                    </h3>
                    <div class="space-y-2 text-xs">
                        <div>
                            <span class="text-slate-400 font-medium block">Paroisse / Eglise</span>
                            <span class="text-indigo-700 font-bold">{{ fiangonanaNom }}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 font-medium block">Zone / Groupe Géographique</span>
                            <span class="text-slate-800 font-semibold">{{ groupeNom }}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 font-medium block">Associations d'appartenance</span>
                            <span class="text-slate-800 font-semibold">{{ associationsStr }}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 font-medium block">Mandats & Responsabilités actifs</span>
                            {% if activeRoles is not empty %}
                                <ul class="mt-1 space-y-1">
                                    {% for r in activeRoles %}
                                        <li class="bg-indigo-50 border border-indigo-100 text-indigo-900 rounded px-2 py-1 font-medium flex justify-between">
                                            <span>{{ r.role }} ({{ r.context }})</span>
                                            <span class="text-indigo-500 font-mono text-[10px]">{{ r.exerciceYear }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <span class="text-slate-500 italic">Aucun mandat attribué</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Integrated Printable Member Card with QR Code -->
            <div class="bg-gradient-to-br from-indigo-50 via-slate-50 to-blue-50 p-6 rounded-2xl border border-indigo-100 flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex-1 space-y-2 text-center md:text-left">
                    <span class="bg-indigo-600 text-white text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-1 rounded-md">
                        Carte avec QR Code de Pointage
                    </span>
                    <h4 class="text-lg font-bold text-slate-800">Pass Officiel de Présence</h4>
                    <p class="text-xs text-slate-600 max-w-md">
                        Cette carte est munie d'un QR code unique. Lors des réunions, événements des groupes/associations ou formations des jeunes, le responsable scanne ce QR code pour pointer automatiquement la présence du membre.
                    </p>
                    <p class="text-[11px] font-mono text-indigo-700 font-semibold">
                        URL de scan: {{ scanUrl }}
                    </p>
                </div>
                <!-- Embedded QR Card Container -->
                <div class="bg-white p-4 rounded-xl shadow-lg border border-slate-200 flex flex-col items-center min-w-[180px]">
                    <img src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code Membre" class="w-32 h-32 object-contain">
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider mt-2">QR Code de Présence</span>
                    <span class="text-[10px] font-mono font-extrabold text-slate-700 mt-0.5">#{{ memberId }}</span>
                </div>
            </div>

            <!-- Section 3: Annual Participation Statistics -->
            <div class="space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-2 border-b border-slate-200">
                    <h3 class="text-base font-bold text-slate-800 uppercase tracking-wider flex items-center">
                        <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Bilan Annuel de Participation ({{ year }})
                    </h3>
                </div>

                <!-- Key Metrics Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-indigo-50 border border-indigo-100 p-4 rounded-xl text-center">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 block">Activités Prévues</span>
                        <span class="text-2xl font-black text-indigo-950 mt-1 block">{{ stats.totalActivitiesCount ?? 0 }}</span>
                    </div>

                    <div class="bg-emerald-50 border border-emerald-100 p-4 rounded-xl text-center">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 block">Présences Effectives</span>
                        <span class="text-2xl font-black text-emerald-950 mt-1 block">{{ stats.attendedActivitiesCount ?? 0 }}</span>
                    </div>

                    <div class="bg-blue-50 border border-blue-100 p-4 rounded-xl text-center">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600 block">Taux de Participation</span>
                        <span class="text-2xl font-black text-blue-950 mt-1 block">{{ stats.participationRate ?? 0 }}%</span>
                    </div>

                    <div class="bg-amber-50 border border-amber-100 p-4 rounded-xl text-center">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600 block">Taux de Retard</span>
                        <span class="text-2xl font-black text-amber-950 mt-1 block">{{ stats.lateRate ?? 0 }}%</span>
                    </div>
                </div>

                <!-- Detailed Presence Logs Table -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl overflow-hidden mt-4">
                    <div class="px-4 py-3 bg-slate-100 border-b border-slate-200 flex justify-between items-center">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">Historique des Présences / Scans</h4>
                        <span class="text-xs text-slate-500 font-medium">{{ stats.presenceLogs|length }} enregistrement(s)</span>
                    </div>
                    {% if stats.presenceLogs is not empty %}
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-700">
                                <thead class="bg-slate-200/60 uppercase text-[10px] tracking-wider text-slate-600">
                                    <tr>
                                        <th class="py-2.5 px-4 font-semibold">Activité / Événement</th>
                                        <th class="py-2.5 px-4 font-semibold">Date & Heure Scan</th>
                                        <th class="py-2.5 px-4 font-semibold">Statut Pontualité</th>
                                        <th class="py-2.5 px-4 font-semibold">Opérateur Scan</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200">
                                    {% for log in stats.presenceLogs %}
                                        <tr class="hover:bg-slate-100/80 transition">
                                            <td class="py-2.5 px-4 font-semibold text-slate-800">{{ log.activityName }}</td>
                                            <td class="py-2.5 px-4 font-mono text-slate-600">{{ log.scannedAt|date('d/m/Y H:i:s') }}</td>
                                            <td class="py-2.5 px-4">
                                                {% if log.isLate %}
                                                    <span class="bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded text-[10px] inline-block">
                                                        Retard (+{{ log.delayMinutes }} min)
                                                    </span>
                                                {% else %}
                                                    <span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded text-[10px] inline-block">
                                                        À l'heure
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td class="py-2.5 px-4 text-slate-600">
                                                {% if log.scannedBy %}
                                                    {{ log.scannedBy.prenom }} {{ log.scannedBy.nom }}
                                                {% else %}
                                                    <span class="italic text-slate-400">Système / Direct</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="p-6 text-center text-slate-400 italic text-xs">
                            Aucune présence enregistrée pour l'année {{ year }}.
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

        <!-- Sheet Footer -->
        <div class="bg-slate-100 px-8 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500">
            <span>Fiche Membre émise le {{ 'now'|date('d/m/Y H:i') }}</span>
            <span class="font-semibold text-slate-700">Système de Gestion Paroissiale - Section Présences & Cartes</span>
        </div>
    </div>

</body>
</html>
