<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #cbd5e1;
                margin: 0 auto;
                max-width: 100% !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-start py-8 px-4">

    <!-- Action Bar for Printing & Navigation -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche membre
        </button>
    </div>

    <!-- Printable Member Fiche Container -->
    <div class="print-card bg-white w-full max-w-3xl rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col relative">

        <!-- Top Header Banner -->
        <div class="bg-gradient-to-r from-blue-800 via-indigo-800 to-indigo-900 text-white p-6 flex justify-between items-center border-b border-indigo-900">
            <div>
                <span class="bg-blue-500/30 text-blue-100 text-xs uppercase font-bold tracking-widest px-3 py-1 rounded-full border border-blue-400/30">
                    Fiche Indivuduelle de Membre
                </span>
                <h1 class="text-2xl font-black mt-2 tracking-tight">{{ fiangonanaNom }}</h1>
                <p class="text-xs text-blue-200 mt-1">Identifiant Membre: #{{ memberId }}</p>
            </div>
            <!-- Member Photo or Avatar Placeholder -->
            <div class="flex-shrink-0">
                {% if photoUrl %}
                    <img src="{{ photoUrl }}" alt="Photo de {{ prenom }}" class="w-20 h-20 rounded-full object-cover border-2 border-white/80 shadow-md" />
                {% else %}
                    <div class="w-20 h-20 rounded-full bg-indigo-600 border-2 border-white/80 flex items-center justify-center text-white text-2xl font-bold shadow-md">
                        {{ prenom|slice(0,1)|upper }}{{ nom|slice(0,1)|upper }}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="p-6 space-y-6">

            <!-- General Member Information & QR Code Badge -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">

                <!-- Left 2 columns: Identity & Contact Info -->
                <div class="md:col-span-2 space-y-4">
                    <h2 class="text-xs uppercase font-bold tracking-wider text-slate-400 border-b border-slate-100 pb-1">Informations Personnelles</h2>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Nom</p>
                            <p class="font-bold text-slate-800 text-base">{{ nom }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Prénom</p>
                            <p class="font-bold text-slate-800 text-base">{{ prenom }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Sexe</p>
                            <p class="font-medium text-slate-700">{{ sexe == 'M' ? 'Masculin' : (sexe == 'F' ? 'Féminin' : sexe) }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Date de Naissance</p>
                            <p class="font-medium text-slate-700">{{ dateNaissance }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Téléphone</p>
                            <p class="font-medium text-slate-700">{{ telephone }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Email</p>
                            <p class="font-medium text-slate-700 truncate">{{ email }}</p>
                        </div>
                    </div>

                    <div class="pt-2">
                        <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Adresse</p>
                        <p class="font-medium text-slate-700 text-sm">{{ adresse }}</p>
                    </div>

                    <h2 class="text-xs uppercase font-bold tracking-wider text-slate-400 border-b border-slate-100 pb-1 pt-2">Rattachements Structurels</h2>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Paroisse / Eglise</p>
                            <p class="font-semibold text-slate-800">{{ fiangonanaNom }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Zone / Groupe</p>
                            <p class="font-semibold text-slate-800">{{ groupeNom }}</p>
                        </div>
                        <div class="col-span-2">
                            <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Associations Rattachées</p>
                            <p class="font-medium text-slate-700">{{ associationsStr }}</p>
                        </div>
                    </div>
                </div>

                <!-- Right 1 column: Printable QR Code Card -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm text-center">
                    <p class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Carte de Pointage QR Code</p>
                    <img class="w-36 h-36 mix-blend-multiply my-1" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du Membre" />
                    <p class="text-[10px] text-slate-500 font-medium mt-1">À présenter lors des activités, formations et cultes</p>
                    <span class="mt-2 text-[10px] bg-slate-200 text-slate-700 font-mono py-1 px-2 rounded font-bold">
                        Token: {{ token }}
                    </span>
                </div>

            </div>

            <!-- Participation & Attendance Summary Section -->
            <div class="border-t border-slate-200 pt-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-sm uppercase font-bold tracking-wider text-slate-800 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Bilan de Participation Annuel ({{ year }})
                    </h2>
                    <span class="text-xs text-slate-500 font-medium">Taux Global: <strong class="text-indigo-600">{{ stats.participationRate }}%</strong></span>
                </div>

                <!-- Stat KPI Cards -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                    <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3">
                        <p class="text-[10px] font-bold uppercase text-indigo-500 tracking-wider">Activités Totales</p>
                        <p class="text-2xl font-black text-indigo-900 mt-1">{{ stats.totalActivitiesCount }}</p>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-3">
                        <p class="text-[10px] font-bold uppercase text-emerald-500 tracking-wider">Présences</p>
                        <p class="text-2xl font-black text-emerald-900 mt-1">{{ stats.attendedActivitiesCount }}</p>
                    </div>
                    <div class="bg-amber-50 border border-amber-100 rounded-xl p-3">
                        <p class="text-[10px] font-bold uppercase text-amber-500 tracking-wider">A l'heure</p>
                        <p class="text-2xl font-black text-amber-900 mt-1">{{ stats.onTimeCount }}</p>
                    </div>
                    <div class="bg-rose-50 border border-rose-100 rounded-xl p-3">
                        <p class="text-[10px] font-bold uppercase text-rose-500 tracking-wider">Retards</p>
                        <p class="text-2xl font-black text-rose-900 mt-1">{{ stats.lateCount }}</p>
                    </div>
                </div>

                <!-- Recent Attendance Logs Table -->
                {% if stats.presenceLogs is defined and stats.presenceLogs|length > 0 %}
                    <div class="mt-4">
                        <p class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Derniers Pointages de Présence</p>
                        <div class="overflow-x-auto rounded-lg border border-slate-200">
                            <table class="w-full text-left text-xs text-slate-700">
                                <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] font-semibold border-b border-slate-200">
                                    <tr>
                                        <th class="py-2 px-3">Activité / Événement</th>
                                        <th class="py-2 px-3">Date & Heure de Pointage</th>
                                        <th class="py-2 px-3">Statut</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    {% for log in stats.presenceLogs|slice(0, 5) %}
                                        <tr class="hover:bg-slate-50">
                                            <td class="py-2 px-3 font-semibold text-slate-800">{{ log.activityName }}</td>
                                            <td class="py-2 px-3 text-slate-600">{{ log.scannedAt|date("d/m/Y H:i") }}</td>
                                            <td class="py-2 px-3">
                                                {% if log.isLate %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">
                                                        Retard (+{{ log.delayMinutes }} min)
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                                        À l'heure
                                                    </span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}

            </div>

        </div>

        <!-- Footer Bar -->
        <div class="bg-slate-50 px-6 py-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
            <span>Document Officiel Paroissial - Fiche Membre #{{ memberId }}</span>
            <span>Généré le {{ "now"|date("d/m/Y à H:i") }}</span>
        </div>

    </div>

</body>
</html>
