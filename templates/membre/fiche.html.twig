<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-container {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen py-8 px-4 flex flex-col items-center">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche individuelle
        </button>
    </div>

    <!-- Printable Fiche Container -->
    <div class="print-container bg-white w-full max-w-3xl rounded-3xl shadow-xl overflow-hidden border border-slate-200">

        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-purple-800 text-white p-6 flex justify-between items-center">
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-blue-200">Fiche Individuelle de Membre</p>
                <h1 class="text-xl font-bold mt-1">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <span class="bg-white/20 text-white text-xs font-bold px-3 py-1.5 rounded-lg border border-white/30 backdrop-blur-sm">
                    ID Membre: #{{ memberId }}
                </span>
            </div>
        </div>

        <!-- Body Content -->
        <div class="p-8 space-y-8">

            <!-- Personal Info & QR Code Section -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">

                <!-- Left: Photo & Main Info -->
                <div class="md:col-span-2 flex flex-col sm:flex-row items-center sm:items-start space-y-4 sm:space-y-0 sm:space-x-6 text-center sm:text-left">
                    <div class="w-28 h-28 rounded-2xl border-2 border-slate-200 overflow-hidden bg-slate-50 shrink-0 shadow-sm flex items-center justify-center">
                        {% if photoUrl %}
                            <img src="{{ photoUrl }}" alt="{{ prenom }} {{ nom }}" class="w-full h-full object-cover" />
                        {% else %}
                            <div class="w-full h-full bg-indigo-100 text-indigo-700 font-extrabold text-3xl flex items-center justify-center">
                                {{ prenom ? prenom|slice(0, 1)|upper : 'M' }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="space-y-2">
                        <h2 class="text-2xl font-extrabold text-slate-800">{{ prenom }} {{ nom }}</h2>
                        <div class="space-y-1 text-xs text-slate-600">
                            <p><span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Genre:</span> {{ sexe }}</p>
                            <p><span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Email:</span> {{ email ?: 'Non renseigné' }}</p>
                            <p><span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Téléphone:</span> {{ telephone }}</p>
                            <p><span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">Adresse:</span> {{ adresse }}</p>
                        </div>
                    </div>
                </div>

                <!-- Right: QR Code for Scanning -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-4 rounded-2xl border border-slate-200 text-center">
                    <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du Membre" />
                    <p class="text-[9px] uppercase tracking-wider text-slate-500 mt-2 font-bold">Scanner pour présence</p>
                    {% if token is defined and token != 'N/A' %}
                        <p class="text-[8px] font-mono text-slate-400">Token: {{ token }}</p>
                    {% endif %}
                </div>
            </div>

            <hr class="border-slate-100" />

            <!-- Affiliations Grid -->
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-600 mb-3">Rattachements Paroissiaux & Associations</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                        <p class="text-[9px] uppercase font-bold text-slate-400">Paroisse / Fiangonana</p>
                        <p class="font-bold text-slate-800 mt-1">{{ fiangonanaNom }}</p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                        <p class="text-[9px] uppercase font-bold text-slate-400">Zone Géographique / Groupe</p>
                        <p class="font-bold text-slate-800 mt-1">{{ groupeNom }}</p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                        <p class="text-[9px] uppercase font-bold text-slate-400">Associations / Sampana</p>
                        <p class="font-bold text-slate-800 mt-1">{{ associationsStr }}</p>
                    </div>
                </div>
            </div>

            <!-- Participation & Attendance Summary -->
            {% if participationStats is defined and participationStats is not null %}
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-600 mb-3">Bilan d'Assiduité & Participation ({{ year }})</h3>
                <div class="bg-indigo-50/50 p-5 rounded-2xl border border-indigo-100 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
                    <div>
                        <p class="text-[10px] uppercase font-bold text-slate-400">Taux Global</p>
                        <p class="text-2xl font-extrabold text-indigo-600 mt-1">
                            {{ participationStats.overallStats.rate ?? 0 }}%
                        </p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase font-bold text-slate-400">Présences Validées</p>
                        <p class="text-2xl font-extrabold text-slate-800 mt-1">
                            {{ participationStats.overallStats.attendedEvents ?? 0 }} / {{ participationStats.overallStats.totalEvents ?? 0 }}
                        </p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase font-bold text-slate-400">Événements Évalués</p>
                        <p class="text-2xl font-extrabold text-slate-800 mt-1">
                            {{ participationStats.overallStats.totalEvents ?? 0 }}
                        </p>
                    </div>
                </div>
            </div>
            {% endif %}

        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-4 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-400">
            <span>Fiche générée automatiquement le {{ "now"|date("d/m/Y à H:i") }}</span>
            <span class="font-semibold text-slate-500">Système de Gestion Paroissiale</span>
        </div>

    </div>

</body>
</html>
