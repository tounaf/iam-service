<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ prenom }} {{ nom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            body {
                background: white !important;
                margin: 0;
                padding: 0;
                color: #000;
            }
            .no-print {
                display: none !important;
            }
            .print-container {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 auto !important;
                max-width: 100% !important;
            }
            .page-break {
                page-break-before: always;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen p-4 md:p-8 text-slate-800">

    <!-- Action Bar for Printing -->
    <div class="no-print max-w-4xl mx-auto mb-6 flex items-center justify-between bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex items-center space-x-3">
            <span class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg">
                <i class="fa-solid fa-file-invoice"></i>
            </span>
            <div>
                <h1 class="text-sm font-extrabold text-slate-800">Fiche Individuelle de Membre</h1>
                <p class="text-xs text-slate-500">Document officiel récapitulatif & carte de présence</p>
            </div>
        </div>
        <div class="flex items-center space-x-3">
            <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs py-2.5 px-5 rounded-xl shadow-md transition duration-200 flex items-center space-x-2">
                <i class="fa-solid fa-print"></i>
                <span>Imprimer la Fiche</span>
            </button>
        </div>
    </div>

    <!-- Printable Fiche Container -->
    <div class="print-container max-w-4xl mx-auto bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden space-y-6 p-6 md:p-8">

        <!-- Top Header Banner -->
        <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white -m-6 md:-m-8 p-6 md:p-8 mb-6 relative">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <span class="bg-blue-500/30 text-blue-200 text-[10px] uppercase font-extrabold tracking-widest px-3 py-1 rounded-full border border-blue-400/30">
                        Administration Paroissiale
                    </span>
                    <h1 class="text-2xl md:text-3xl font-black mt-2 tracking-tight">{{ fiangonanaNom }}</h1>
                    <p class="text-xs text-blue-200 mt-1 flex items-center">
                        <i class="fa-solid fa-id-card mr-1.5"></i> Fiche Officielle & Code QR de Présence • Année {{ year }}
                    </p>
                </div>
                <div class="text-right bg-white/10 backdrop-blur-md px-4 py-3 rounded-2xl border border-white/10 shrink-0">
                    <p class="text-[10px] uppercase tracking-wider text-blue-200 font-bold">Identifiant Membre</p>
                    <p class="text-xl font-black font-mono tracking-wider">#{{ memberId }}</p>
                </div>
            </div>
        </div>

        <!-- Main Member Profile Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">

            <!-- Left: Photo & QR Code -->
            <div class="flex flex-col items-center space-y-4 bg-slate-50 p-6 rounded-2xl border border-slate-200">
                <!-- Member Avatar / Photo -->
                <div class="w-32 h-40 rounded-2xl overflow-hidden border-2 border-white shadow-md bg-white flex items-center justify-center relative">
                    {% if photoUrl %}
                        <img src="{{ photoUrl }}" alt="{{ prenom }}" class="w-full h-full object-cover">
                    {% else %}
                        <div class="w-full h-full bg-indigo-100 text-indigo-700 flex flex-col items-center justify-center font-bold text-3xl">
                            <i class="fa-solid fa-user text-4xl mb-1"></i>
                            <span class="text-xs uppercase tracking-wider mt-1">{{ prenom|slice(0, 1) }}</span>
                        </div>
                    {% endif %}
                </div>

                <!-- QR Code Box -->
                <div class="w-full bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col items-center text-center space-y-2">
                    <img src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code" class="w-36 h-36 object-contain mix-blend-multiply">
                    <div class="text-[10px] text-slate-500 space-y-0.5">
                        <p class="font-bold text-slate-700 uppercase tracking-wider">Pass Pointage Présence</p>
                        <p class="font-mono text-slate-400">Token: {{ token }}</p>
                    </div>
                </div>
            </div>

            <!-- Right: Details Grid -->
            <div class="md:col-span-2 space-y-6">

                <!-- Personal Information -->
                <div class="space-y-3">
                    <h2 class="text-xs font-black uppercase tracking-wider text-slate-400 border-b border-slate-200 pb-2 flex items-center">
                        <i class="fa-solid fa-user-check text-indigo-600 mr-2"></i> État Civil & Contact
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Nom & Prénom</span>
                            <span class="font-extrabold text-slate-800 text-base">{{ prenom }} {{ nom }}</span>
                        </div>

                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Sexe / Genre</span>
                            <span class="font-bold text-slate-700">
                                {% if sexe == 'M' %}
                                    <i class="fa-solid fa-mars text-blue-600 mr-1"></i> Homme (M)
                                {% elseif sexe == 'F' %}
                                    <i class="fa-solid fa-venus text-pink-600 mr-1"></i> Femme (F)
                                {% else %}
                                    Non spécifié
                                {% endif %}
                            </span>
                        </div>

                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Date de Naissance / Âge</span>
                            <span class="font-bold text-slate-700">
                                {{ dateNaissance|default('Non renseignée') }}
                                {% if age is not null %}({{ age }} ans){% endif %}
                            </span>
                        </div>

                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Téléphone</span>
                            <span class="font-bold text-slate-700">{{ telephone }}</span>
                        </div>

                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Adresse Email</span>
                            <span class="font-bold text-slate-700">{{ email }}</span>
                        </div>

                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Adresse Résidentielle</span>
                            <span class="font-bold text-slate-700">{{ adresse }}</span>
                        </div>
                    </div>
                </div>

                <!-- Affiliations & Rôles -->
                <div class="space-y-3">
                    <h2 class="text-xs font-black uppercase tracking-wider text-slate-400 border-b border-slate-200 pb-2 flex items-center">
                        <i class="fa-solid fa-sitemap text-indigo-600 mr-2"></i> Affiliations Paroissiales & Structure
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Zone / Groupe Géographique</span>
                            <span class="font-extrabold text-slate-800">{{ groupeNom }}</span>
                        </div>

                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Paroisse / Église Attribuée</span>
                            <span class="font-extrabold text-slate-800">{{ fiangonanaNom }}</span>
                        </div>

                        <div class="sm:col-span-2 bg-slate-50 p-3 rounded-xl border border-slate-200">
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Associations Interne</span>
                            <span class="font-bold text-slate-800">{{ associationsStr }}</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Attendance & Participation Statistics -->
        {% if stats is defined and stats is not null %}
            <div class="pt-4 border-t border-slate-200 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                    <h2 class="text-xs font-black uppercase tracking-wider text-slate-400 flex items-center">
                        <i class="fa-solid fa-chart-line text-emerald-600 mr-2"></i> Assiduité & Taux de Participation (Année {{ year }})
                    </h2>
                    <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                        Taux Global : {{ stats.participationRate|default(0) }}%
                    </span>
                </div>

                <!-- KPI Cards -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200">
                        <p class="text-[10px] uppercase font-bold text-slate-400">Total Événements</p>
                        <p class="text-xl font-black text-slate-800 font-mono mt-0.5">{{ stats.totalActivitiesCount|default(0) }}</p>
                    </div>

                    <div class="bg-emerald-50 p-3 rounded-2xl border border-emerald-200">
                        <p class="text-[10px] uppercase font-bold text-emerald-700">Présences Validées</p>
                        <p class="text-xl font-black text-emerald-700 font-mono mt-0.5">{{ stats.attendedActivitiesCount|default(0) }}</p>
                    </div>

                    <div class="bg-indigo-50 p-3 rounded-2xl border border-indigo-200">
                        <p class="text-[10px] uppercase font-bold text-indigo-700">À l'Heure</p>
                        <p class="text-xl font-black text-indigo-700 font-mono mt-0.5">{{ stats.onTimeCount|default(0) }}</p>
                    </div>

                    <div class="bg-amber-50 p-3 rounded-2xl border border-amber-200">
                        <p class="text-[10px] uppercase font-bold text-amber-700">Arrivées Tardives</p>
                        <p class="text-xl font-black text-amber-700 font-mono mt-0.5">{{ stats.lateCount|default(0) }}</p>
                    </div>
                </div>

                <!-- Entity Breakdown if present -->
                {% if stats.entityStats is defined and stats.entityStats is not null %}
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
                        {% for aStat in stats.entityStats.associations|default([]) %}
                            <div class="bg-blue-50/60 p-3 rounded-xl border border-blue-100 space-y-1">
                                <span class="font-bold text-blue-900 block truncate"><i class="fa-solid fa-users text-blue-600 mr-1"></i> {{ aStat.nom }}</span>
                                <div class="flex justify-between text-[11px]">
                                    <span class="text-slate-500">Taux Présence:</span>
                                    <span class="font-bold text-emerald-700">{{ aStat.presenceRate }}%</span>
                                </div>
                            </div>
                        {% endfor %}

                        {% if stats.entityStats.groupe is defined and stats.entityStats.groupe is not null %}
                            <div class="bg-amber-50/60 p-3 rounded-xl border border-amber-100 space-y-1">
                                <span class="font-bold text-amber-900 block truncate"><i class="fa-solid fa-layer-group text-amber-600 mr-1"></i> {{ stats.entityStats.groupe.nom }}</span>
                                <div class="flex justify-between text-[11px]">
                                    <span class="text-slate-500">Taux Présence:</span>
                                    <span class="font-bold text-emerald-700">{{ stats.entityStats.groupe.presenceRate }}%</span>
                                </div>
                            </div>
                        {% endif %}

                        {% if stats.entityStats.fiangonana is defined and stats.entityStats.fiangonana is not null %}
                            <div class="bg-emerald-50/60 p-3 rounded-xl border border-emerald-100 space-y-1">
                                <span class="font-bold text-emerald-900 block truncate"><i class="fa-solid fa-church text-emerald-600 mr-1"></i> {{ stats.entityStats.fiangonana.nom }}</span>
                                <div class="flex justify-between text-[11px]">
                                    <span class="text-slate-500">Taux Présence:</span>
                                    <span class="font-bold text-emerald-700">{{ stats.entityStats.fiangonana.presenceRate }}%</span>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <!-- Document Footer -->
        <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-2">
            <span>Fiche émise le {{ 'now'|date('d/m/Y H:i') }} • Document Officiel Paroissial</span>
            <span class="font-mono font-bold text-slate-500">Validité Permanente</span>
        </div>

    </div>

</body>
</html>
