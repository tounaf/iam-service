<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4 md:p-8">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center text-sm">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche individuelle
        </button>
        <a href="/api/membres/{{ memberId }}/carte" target="_blank" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold py-2.5 px-6 rounded-xl shadow-sm transition duration-200 flex items-center text-sm">
            Voir la carte format format carte d'identité &rarr;
        </a>
    </div>

    <!-- Printable Individual Member Sheet (Fiche Membre) -->
    <div class="print-card bg-white w-full max-w-3xl rounded-2xl shadow-xl overflow-hidden border border-slate-200">
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-slate-900 via-indigo-900 to-blue-900 text-white p-6 flex justify-between items-center">
            <div>
                <p class="text-xs uppercase tracking-widest text-indigo-300 font-semibold mb-1">Fiche Individuelle Officielle</p>
                <h1 class="text-2xl font-bold">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <span class="inline-block bg-indigo-500/30 text-indigo-200 text-xs font-semibold px-3 py-1 rounded-full border border-indigo-400/30">
                    ID Membre: #{{ memberId }}
                </span>
                <p class="text-[10px] text-slate-300 mt-1">Générée le {{ "now"|date("d/m/Y") }}</p>
            </div>
        </div>

        <!-- Identity Header Section -->
        <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row items-center md:items-start justify-between gap-6">
            <div class="flex items-center space-x-5">
                {% if photoUrl %}
                    <img src="{{ photoUrl }}" alt="{{ nom }}" class="w-24 h-24 rounded-2xl object-cover border-2 border-indigo-200 shadow-md" />
                {% else %}
                    <div class="w-24 h-24 rounded-2xl bg-indigo-100 text-indigo-700 font-bold text-3xl flex items-center justify-center border-2 border-indigo-200 shadow-sm">
                        {{ prenom|slice(0, 1)|upper }}{{ nom|slice(0, 1)|upper }}
                    </div>
                {% endif %}
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">{{ prenom }} {{ nom }}</h2>
                    <div class="flex flex-wrap gap-2 mt-2 text-xs text-slate-600">
                        <span class="bg-slate-200/80 px-2.5 py-1 rounded-md font-medium">Sexe: {{ sexe }}</span>
                        <span class="bg-slate-200/80 px-2.5 py-1 rounded-md font-medium">Né(e) le: {{ dateNaissance }}</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-2">✉ {{ email }} | 📱 {{ telephone }}</p>
                </div>
            </div>

            <!-- QR Code Box -->
            <div class="flex flex-col items-center bg-white p-3 rounded-2xl border border-slate-200 shadow-sm">
                <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code" />
                <span class="text-[9px] uppercase tracking-wider font-bold text-slate-400 mt-1">Code QR d'émargement</span>
                {% if token is defined and token != 'N/A' %}
                    <span class="text-[9px] text-slate-400 font-mono">Token: {{ token }}</span>
                {% endif %}
            </div>
        </div>

        <!-- Main Body: Affiliations & Attendance Stats -->
        <div class="p-6 space-y-6">
            <!-- Affiliations & Roles Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80 space-y-2">
                    <h3 class="text-xs uppercase tracking-wider font-bold text-indigo-700">Rattachements Structurels</h3>
                    <div class="text-sm space-y-1.5">
                        <p><span class="text-slate-500 font-medium">Paroisse / Fiangonana:</span> <strong class="text-slate-800">{{ fiangonanaNom }}</strong></p>
                        <p><span class="text-slate-500 font-medium">Zone Geographique / Groupe:</span> <strong class="text-slate-800">{{ groupeNom }}</strong></p>
                        <p><span class="text-slate-500 font-medium">Associations:</span> <strong class="text-slate-800">{{ associationsStr }}</strong></p>
                    </div>
                </div>

                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80 space-y-2">
                    <h3 class="text-xs uppercase tracking-wider font-bold text-indigo-700">Rôles & Responsabilités Active</h3>
                    {% if rolesList is not empty %}
                        <ul class="text-xs space-y-1">
                            {% for r in rolesList %}
                                <li class="flex justify-between items-center bg-white p-2 rounded border border-slate-200">
                                    <span class="font-bold text-slate-800">{{ r.roleName }}</span>
                                    <span class="text-slate-500 text-[10px]">({{ r.contextLabel }} - {{ r.exerciceYear }})</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-xs text-slate-500 italic">Aucun rôle spécifique attribué.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Participation & Attendance Summary for Year -->
            <div class="border border-slate-200 rounded-xl p-5 bg-white space-y-4">
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <h3 class="text-sm font-bold text-slate-900 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Bilan de Présence et Assiduité (Année {{ year }})
                    </h3>
                    <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full">
                        Taux Global: {{ stats.participationRate|default(0) }}%
                    </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                    <div class="bg-indigo-50/60 p-3 rounded-lg border border-indigo-100">
                        <p class="text-[10px] uppercase font-bold text-indigo-600">Événements Totaux</p>
                        <p class="text-xl font-extrabold text-indigo-900 mt-0.5">{{ stats.totalActivitiesCount|default(0) }}</p>
                    </div>
                    <div class="bg-emerald-50/60 p-3 rounded-lg border border-emerald-100">
                        <p class="text-[10px] uppercase font-bold text-emerald-600">Présences Effectives</p>
                        <p class="text-xl font-extrabold text-emerald-900 mt-0.5">{{ stats.attendedActivitiesCount|default(0) }}</p>
                    </div>
                    <div class="bg-amber-50/60 p-3 rounded-lg border border-amber-100">
                        <p class="text-[10px] uppercase font-bold text-amber-600">Retards</p>
                        <p class="text-xl font-extrabold text-amber-900 mt-0.5">{{ stats.lateCount|default(0) }}</p>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
                        <p class="text-[10px] uppercase font-bold text-slate-500">À l'heure</p>
                        <p class="text-xl font-extrabold text-slate-800 mt-0.5">{{ stats.onTimeCount|default(0) }}</p>
                    </div>
                </div>

                <!-- Entity Breakdown Stats -->
                {% if stats.entityStats is defined %}
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Répartition par entité rattachée</h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                            {% for a in stats.entityStats.associations|default([]) %}
                                <div class="bg-slate-50 p-2.5 rounded border border-slate-200 flex justify-between items-center">
                                    <div>
                                        <p class="font-bold text-slate-800">{{ a.nom }}</p>
                                        <p class="text-[10px] text-slate-500">{{ a.attended }}/{{ a.totalEvents }} évènements assistés</p>
                                    </div>
                                    <span class="font-bold text-indigo-600 bg-white px-2 py-0.5 rounded border border-slate-200">{{ a.presenceRate }}%</span>
                                </div>
                            {% endfor %}

                            {% if stats.entityStats.groupe is defined and stats.entityStats.groupe is not null %}
                                <div class="bg-slate-50 p-2.5 rounded border border-slate-200 flex justify-between items-center">
                                    <div>
                                        <p class="font-bold text-slate-800">Zone: {{ stats.entityStats.groupe.nom }}</p>
                                        <p class="text-[10px] text-slate-500">{{ stats.entityStats.groupe.attended }}/{{ stats.entityStats.groupe.totalEvents }} évènements assistés</p>
                                    </div>
                                    <span class="font-bold text-indigo-600 bg-white px-2 py-0.5 rounded border border-slate-200">{{ stats.entityStats.groupe.presenceRate }}%</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-6 py-3 border-t border-slate-200 flex justify-between items-center text-[10px] text-slate-500">
            <span>Fiangonana & Paroisse - Gestion des Membres</span>
            <span>Document officiel d'identification</span>
        </div>
    </div>

</body>
</html>
