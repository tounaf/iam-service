<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #ccc;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la fiche
        </button>
    </div>

    <!-- Member Fiche Container -->
    <div class="print-card bg-white w-full max-w-[650px] rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col relative my-4">
        <!-- Top Colored Header Bar -->
        <div class="bg-gradient-to-r from-slate-800 to-indigo-900 text-white p-6 flex justify-between items-center">
            <div>
                <h2 class="text-xs font-semibold uppercase tracking-widest text-indigo-300">Fiche Individuelle de Membre</h2>
                <h1 class="text-xl font-bold truncate max-w-[400px] mt-1">{{ fiangonanaNom }}</h1>
            </div>
            <span class="bg-indigo-500/30 text-indigo-100 text-xs font-bold px-3 py-1.5 rounded-full border border-indigo-400/30">
                #{{ memberId }}
            </span>
        </div>

        <!-- Main Fiche Body -->
        <div class="p-6 space-y-6">
            <!-- Header Section: Name + QR Code -->
            <div class="flex flex-row items-start justify-between border-b border-slate-100 pb-6">
                <div class="space-y-2">
                    <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Identité du membre</p>
                    <h3 class="text-2xl font-extrabold text-slate-900 leading-tight">{{ prenom }} {{ nom }}</h3>
                    <div class="flex items-center space-x-3 text-sm text-slate-600">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                            Sexe: {{ sexe }}
                        </span>
                        <span>•</span>
                        <span>ID: #{{ memberId }}</span>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <img class="w-28 h-28 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code Membre" />
                    <span class="text-[9px] uppercase tracking-wider text-slate-500 mt-1 font-bold">Code QR Présence</span>
                </div>
            </div>

            <!-- Affiliations Grid -->
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Rattachement & Structure</h4>
                <div class="grid grid-cols-2 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <div>
                        <p class="text-[10px] uppercase text-slate-400 font-bold">Paroisse / Fiangonana</p>
                        <p class="text-sm font-semibold text-slate-800 mt-0.5">{{ fiangonanaNom }}</p>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase text-slate-400 font-bold">Zone / Groupe</p>
                        <p class="text-sm font-semibold text-slate-800 mt-0.5">{{ groupeNom }}</p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-[10px] uppercase text-slate-400 font-bold">Associations / Sampana</p>
                        <p class="text-sm font-semibold text-slate-800 mt-0.5">{{ associationsStr }}</p>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Coordonnées</h4>
                <div class="grid grid-cols-2 gap-4 text-xs">
                    <div class="bg-white p-3 rounded-lg border border-slate-200">
                        <p class="text-[10px] uppercase text-slate-400 font-bold">Email</p>
                        <p class="font-medium text-slate-700 mt-0.5 truncate">{{ email }}</p>
                    </div>
                    <div class="bg-white p-3 rounded-lg border border-slate-200">
                        <p class="text-[10px] uppercase text-slate-400 font-bold">Téléphone</p>
                        <p class="font-medium text-slate-700 mt-0.5">{{ telephone }}</p>
                    </div>
                    <div class="col-span-2 bg-white p-3 rounded-lg border border-slate-200">
                        <p class="text-[10px] uppercase text-slate-400 font-bold">Adresse</p>
                        <p class="font-medium text-slate-700 mt-0.5">{{ adresse }}</p>
                    </div>
                </div>
            </div>

            <!-- Attendance Stats Overview (if available) -->
            {% if stats is defined and stats is not null %}
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Taux de Participation Annuel ({{ year }})</h4>
                <div class="bg-indigo-50/60 p-4 rounded-xl border border-indigo-100 flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-black text-indigo-900">{{ stats.participationRate }}%</p>
                        <p class="text-xs text-indigo-700 font-medium">Taux global de présence</p>
                    </div>
                    <div class="text-right text-xs text-slate-600 space-y-1">
                        <p><span class="font-bold text-slate-800">{{ stats.attendedActivitiesCount }}</span> / {{ stats.totalActivitiesCount }} activités assistées</p>
                        {% if stats.lateCount is defined %}
                        <p class="text-amber-700 font-medium">{{ stats.lateCount }} retard(s) enregistré(s)</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Fiche Footer -->
        <div class="bg-slate-50 px-6 py-3 border-t border-slate-100 flex justify-between items-center text-[11px] text-slate-500">
            <span>Token QR: <code class="bg-slate-200 px-1.5 py-0.5 rounded text-slate-700">{{ token }}</code></span>
            <span>Document Officiel</span>
        </div>
    </div>

</body>
</html>
