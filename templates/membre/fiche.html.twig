<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ prenom }} {{ nom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-container {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen py-8 px-4 flex flex-col items-center justify-start">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition duration-200 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            Imprimer la Fiche Membre
        </button>
    </div>

    <!-- Main Fiche Document -->
    <div class="print-container bg-white w-full max-w-4xl rounded-2xl shadow-xl overflow-hidden border border-slate-200">
        <!-- Header -->
        <div class="bg-gradient-to-r from-slate-800 via-indigo-900 to-blue-900 text-white p-6 md:p-8 flex justify-between items-center">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-indigo-300">Fiche Individuelle de Membre</span>
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mt-1">{{ fiangonanaNom }}</h1>
                <p class="text-xs text-slate-300 mt-1">Saisie & Suivi de Présence Annuel #{{ year }}</p>
            </div>
            <div class="text-right flex flex-col items-end">
                <span class="inline-block bg-indigo-500/30 text-indigo-200 border border-indigo-400/30 text-xs px-3 py-1 rounded-full font-semibold">
                    ID Membre: #{{ memberId }}
                </span>
                {% if token is defined and token != 'N/A' %}
                    <span class="text-[11px] text-slate-300 mt-2 font-mono">Token: {{ token }}</span>
                {% endif %}
            </div>
        </div>

        <!-- Body -->
        <div class="p-6 md:p-8 space-y-8">

            <!-- Member Identity & QR Code Section -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start pb-6 border-b border-slate-200">
                <!-- Photo & Basic Identity -->
                <div class="flex flex-col items-center text-center md:items-start md:text-left space-y-3">
                    <div class="relative w-32 h-32 rounded-2xl overflow-hidden border-2 border-indigo-100 shadow-md bg-slate-100 flex items-center justify-center">
                        {% if photoUrl %}
                            <img src="{{ photoUrl }}" alt="{{ prenom }} {{ nom }}" class="w-full h-full object-cover" />
                        {% else %}
                            <div class="w-full h-full flex flex-col items-center justify-center bg-indigo-50 text-indigo-400 font-bold text-2xl">
                                {{ prenom|first|upper }}{{ nom|first|upper }}
                            </div>
                        {% endif %}
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900 leading-tight">{{ prenom }} {{ nom }}</h2>
                        <p class="text-sm font-medium text-indigo-600 mt-1">{{ groupeNom }}</p>
                    </div>
                </div>

                <!-- Personal Information Grid -->
                <div class="grid grid-cols-1 gap-3 text-sm text-slate-700 md:col-span-1 border-t md:border-t-0 md:border-l border-slate-200 pt-4 md:pt-0 md:pl-6">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Informations Générales</h3>
                    <div>
                        <span class="text-slate-400 text-xs block font-semibold">Email</span>
                        <span class="font-medium text-slate-800">{{ email|default('Non renseigné') }}</span>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs block font-semibold">Téléphone</span>
                        <span class="font-medium text-slate-800">{{ telephone|default('Non renseigné') }}</span>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs block font-semibold">Adresse</span>
                        <span class="font-medium text-slate-800">{{ adresse|default('Non renseignée') }}</span>
                    </div>
                    <div>
                        <span class="text-slate-400 text-xs block font-semibold">Associations</span>
                        <span class="font-medium text-slate-800">{{ associationsStr }}</span>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div class="flex flex-col items-center justify-center bg-slate-50 p-4 rounded-2xl border border-slate-200 shadow-inner md:col-span-1">
                    <img class="w-36 h-36 mix-blend-multiply" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code" />
                    <p class="text-xs font-bold text-slate-700 mt-2 text-center">Scanner pour pointer la présence</p>
                    <p class="text-[10px] text-slate-400 text-center mt-1">Badge d'accès événements & formations</p>
                </div>
            </div>

            <!-- Participation Statistics Summary -->
            {% if stats is defined and stats is not null %}
            <div>
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-4 flex items-center">
                    <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Statistiques de Présence Année {{ year }}
                </h3>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-indigo-50/60 p-4 rounded-xl border border-indigo-100 text-center">
                        <span class="text-xs text-indigo-600 font-semibold block">Taux de Participation</span>
                        <span class="text-2xl font-extrabold text-indigo-900 mt-1 block">{{ stats.participationRate }}%</span>
                    </div>
                    <div class="bg-emerald-50/60 p-4 rounded-xl border border-emerald-100 text-center">
                        <span class="text-xs text-emerald-600 font-semibold block">Activités Assistées</span>
                        <span class="text-2xl font-extrabold text-emerald-900 mt-1 block">{{ stats.attendedActivitiesCount }} / {{ stats.totalActivitiesCount }}</span>
                    </div>
                    <div class="bg-amber-50/60 p-4 rounded-xl border border-amber-100 text-center">
                        <span class="text-xs text-amber-600 font-semibold block">Présences à l'heure</span>
                        <span class="text-2xl font-extrabold text-amber-900 mt-1 block">{{ stats.onTimeCount }}</span>
                    </div>
                    <div class="bg-rose-50/60 p-4 rounded-xl border border-rose-100 text-center">
                        <span class="text-xs text-rose-600 font-semibold block">Retards Enregistrés</span>
                        <span class="text-2xl font-extrabold text-rose-900 mt-1 block">{{ stats.lateCount }}</span>
                    </div>
                </div>

                <!-- Presence logs table -->
                {% if stats.presenceLogs is defined and stats.presenceLogs|length > 0 %}
                <div class="mt-6 overflow-x-auto">
                    <h4 class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Historique récent des présences</h4>
                    <table class="w-full text-left text-xs text-slate-700 border border-slate-200 rounded-lg overflow-hidden">
                        <thead class="bg-slate-100 text-slate-600 uppercase font-bold text-[10px]">
                            <tr>
                                <th class="p-3 border-b">Activité / Événement</th>
                                <th class="p-3 border-b">Date & Heure du Scan</th>
                                <th class="p-3 border-b text-center">Statut</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 bg-white">
                            {% for log in stats.presenceLogs %}
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 font-medium text-slate-900">{{ log.activityName }}</td>
                                <td class="p-3 text-slate-600">{{ log.scannedAt|date('d/m/Y H:i') }}</td>
                                <td class="p-3 text-center">
                                    {% if log.isLate %}
                                        <span class="bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded font-bold">Retard ({{ log.delayMinutes }} min)</span>
                                    {% else %}
                                        <span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded font-bold">À l'heure</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
            {% endif %}

        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 text-xs text-slate-500 flex justify-between items-center">
            <span>{{ fiangonanaNom }} - Fiche membre officielle</span>
            <span>Généré le {{ "now"|date("d/m/Y H:i") }}</span>
        </div>
    </div>

</body>
</html>
