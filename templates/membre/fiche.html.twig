<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-card {
                box-shadow: none;
                border: 1px solid #ccc;
                margin: 0 auto;
                width: 100%;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen py-8 px-4 flex flex-col items-center">

    <!-- Action Bar -->
    <div class="no-print mb-6 w-full max-w-4xl flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <div class="flex items-center space-x-3">
            <span class="text-slate-500 text-sm font-medium">Fiche Membre Officielle (#{{ memberId }})</span>
        </div>
        <div class="flex space-x-3">
            <a href="{{ carteUrl }}" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-sm py-2 px-4 rounded-lg border border-slate-300 transition duration-200 flex items-center">
                <svg class="w-4 h-4 mr-2 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                Voir la Carte
            </a>
            <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2 px-5 rounded-lg shadow-sm transition duration-200 flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                Imprimer la fiche
            </button>
        </div>
    </div>

    <!-- Main Fiche Document -->
    <div class="print-card bg-white w-full max-w-4xl rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col">

        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-800 via-indigo-800 to-slate-900 text-white p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="flex items-center space-x-5">
                {% if photoUrl is defined and photoUrl %}
                    <img src="{{ photoUrl }}" alt="Photo de {{ nom }}" class="w-20 h-20 rounded-full object-cover border-2 border-white/50 shadow">
                {% else %}
                    <div class="w-20 h-20 rounded-full bg-indigo-600/50 border-2 border-white/40 flex items-center justify-center text-white text-2xl font-bold shadow">
                        {{ prenom|slice(0, 1)|upper }}{{ nom|slice(0, 1)|upper }}
                    </div>
                {% endif %}
                <div>
                    <span class="text-xs font-semibold uppercase tracking-widest text-indigo-200 block mb-1">Fiche Individuelle du Membre</span>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white">{{ nom }} {{ prenom }}</h1>
                    <p class="text-sm text-indigo-100 font-medium mt-1">{{ fiangonanaNom }}</p>
                </div>
            </div>

            <div class="flex flex-col items-end text-right">
                <span class="bg-indigo-500/30 text-white text-xs font-semibold px-3 py-1 rounded-full border border-indigo-400/30 mb-1">
                    ID Membre: #{{ memberId }}
                </span>
                <span class="text-xs text-indigo-200">Année de référence: <strong>{{ year }}</strong></span>
            </div>
        </div>

        <div class="p-6 sm:p-8 space-y-8">

            <!-- Section 1: Informations Personnelles & Contacts -->
            <div>
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center">
                    <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    Informations Personnelles
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 bg-slate-50 p-5 rounded-xl border border-slate-100">
                    <div>
                        <p class="text-xs text-slate-400 font-medium">Nom complet</p>
                        <p class="text-sm font-semibold text-slate-800">{{ nom }} {{ prenom }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-medium">Sexe</p>
                        <p class="text-sm font-semibold text-slate-800">
                            {% if sexe == 'M' %}Masculin{% elseif sexe == 'F' %}Féminin{% else %}{{ sexe }}{% endif %}
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-medium">Date de naissance</p>
                        <p class="text-sm font-semibold text-slate-800">{{ dateNaissance }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-medium">Adresse e-mail</p>
                        <p class="text-sm font-semibold text-slate-800 break-all">{{ email }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-medium">Téléphone</p>
                        <p class="text-sm font-semibold text-slate-800">{{ telephone }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-medium">Adresse géographique</p>
                        <p class="text-sm font-semibold text-slate-800">{{ adresse }}</p>
                    </div>
                </div>
            </div>

            <!-- Section 2: Affiliations & QR Code de présence -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Left: Affiliations -->
                <div class="md:col-span-2 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h5m-5 0V9m0 0h-2m2 0h2"></path>
                        </svg>
                        Rattachement & Structure
                    </h2>
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-100 space-y-3">
                        <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
                            <span class="text-xs text-slate-500 font-medium">Paroisse (Fiangonana)</span>
                            <span class="text-sm font-bold text-slate-800">{{ fiangonanaNom }}</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
                            <span class="text-xs text-slate-500 font-medium">Zone / Groupe Récolté</span>
                            <span class="text-sm font-bold text-slate-800">{{ groupeNom }}</span>
                        </div>
                        <div class="py-1">
                            <span class="text-xs text-slate-500 font-medium block mb-2">Associations affiliées</span>
                            {% if associationsList is not empty %}
                                <div class="flex flex-wrap gap-2">
                                    {% for assoc in associationsList %}
                                        <span class="bg-indigo-50 text-indigo-700 font-semibold text-xs px-3 py-1 rounded-md border border-indigo-100">
                                            {{ assoc }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-xs text-slate-400 italic">Aucune association enregistrée</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Right: QR Code for scan -->
                <div class="flex flex-col items-center justify-center bg-indigo-50/50 p-5 rounded-xl border border-indigo-100 text-center">
                    <img class="w-36 h-36 bg-white p-2 rounded-lg shadow-sm border border-slate-200 mb-3" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code du membre" />
                    <span class="text-xs font-bold text-indigo-900 mb-1">Code QR de Présence</span>
                    <span class="text-[10px] text-slate-500 font-mono bg-white px-2 py-0.5 rounded border border-slate-200 mb-1">Token: {{ token }}</span>
                    <p class="text-[10px] text-slate-500">Scannez ce QR Code pour enregistrer instantanément la présence à une activité ou formation.</p>
                </div>
            </div>

            <!-- Section 3: Statistiques & Taux de participation annuel -->
            <div>
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center justify-between">
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Taux de Participation Annuel ({{ year }})
                    </span>
                    <span class="text-xs font-semibold text-indigo-600">Calcul en temps réel</span>
                </h2>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
                    <div class="bg-indigo-600 text-white p-4 rounded-xl shadow-sm text-center">
                        <span class="text-xs uppercase font-semibold text-indigo-200 block mb-1">Taux Global</span>
                        <span class="text-2xl sm:text-3xl font-extrabold">{{ stats.participationRate }}%</span>
                    </div>
                    <div class="bg-emerald-50 text-emerald-900 border border-emerald-200 p-4 rounded-xl text-center">
                        <span class="text-xs uppercase font-semibold text-emerald-600 block mb-1">Activités Présentes</span>
                        <span class="text-2xl font-bold text-emerald-800">{{ stats.attendedActivitiesCount }} / {{ stats.totalActivitiesCount }}</span>
                    </div>
                    <div class="bg-amber-50 text-amber-900 border border-amber-200 p-4 rounded-xl text-center">
                        <span class="text-xs uppercase font-semibold text-amber-600 block mb-1">Nombre de Retards</span>
                        <span class="text-2xl font-bold text-amber-800">{{ stats.lateCount }}</span>
                    </div>
                    <div class="bg-slate-50 text-slate-800 border border-slate-200 p-4 rounded-xl text-center">
                        <span class="text-xs uppercase font-semibold text-slate-500 block mb-1">Taux d'A l'Heure</span>
                        <span class="text-2xl font-bold text-slate-700">{{ stats.onTimeRate }}%</span>
                    </div>
                </div>

                <!-- Recent Attendance Logs -->
                <div class="border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                    <div class="bg-slate-100 px-4 py-3 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Journal des Présences Registrées</h3>
                        <span class="text-xs text-slate-500">{{ stats.presenceLogs|length }} événement(s) scanné(s)</span>
                    </div>
                    {% if stats.presenceLogs is not empty %}
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-600">
                                <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b border-slate-200">
                                    <tr>
                                        <th class="py-2.5 px-4">Événement / Activité</th>
                                        <th class="py-2.5 px-4">Date & Heure du scan</th>
                                        <th class="py-2.5 px-4">Statut de ponctualité</th>
                                        <th class="py-2.5 px-4">Enregistré par</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    {% for log in stats.presenceLogs %}
                                        <tr class="hover:bg-slate-50 transition">
                                            <td class="py-3 px-4 font-semibold text-slate-800">{{ log.activityName }}</td>
                                            <td class="py-3 px-4 font-mono text-slate-600">{{ log.scannedAt|date('d/m/Y H:i:s') }}</td>
                                            <td class="py-3 px-4">
                                                {% if log.isLate %}
                                                    <span class="bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded text-[10px] inline-flex items-center">
                                                        Retard (+{{ log.delayMinutes }} min)
                                                    </span>
                                                {% else %}
                                                    <span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded text-[10px] inline-flex items-center">
                                                        A l'heure
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td class="py-3 px-4 text-slate-500">
                                                {% if log.scannedBy %}
                                                    {{ log.scannedBy.prenom }} {{ log.scannedBy.nom }}
                                                {% else %}
                                                    <span class="italic text-slate-400">Scanner Automatique</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="p-6 text-center text-slate-400 text-xs italic">
                            Aucune présence enregistrée pour l'année {{ year }}.
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

        <!-- Footer -->
        <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-2">
            <div>
                Document officiel généré pour le suivi de la paroisse et des associations.
            </div>
            <div class="font-medium text-slate-400">
                Paroisse Management System &copy; {{ "now"|date("Y") }}
            </div>
        </div>

    </div>

</body>
</html>
