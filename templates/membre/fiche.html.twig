<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiche Membre - {{ nom }} {{ prenom }}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .print-fiche {
                box-shadow: none;
                border: 1px solid #e2e8f0;
                margin: 0 auto;
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Action Bar for Printing -->
    <div class="no-print mb-6 flex space-x-4">
        <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center space-x-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
            <span>Imprimer la fiche</span>
        </button>
        <a href="/api/membres/{{ memberId }}/carte" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold py-2.5 px-5 rounded-xl shadow-sm transition duration-200 flex items-center space-x-2">
            <span>Voir la carte</span>
        </a>
    </div>

    <!-- Beautiful Member Fiche Container -->
    <div class="print-fiche bg-white w-full max-w-2xl rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col relative transition duration-300">
        <!-- Top Colored Header Bar -->
        <div class="bg-gradient-to-r from-slate-900 via-indigo-900 to-blue-900 text-white p-6 flex justify-between items-center">
            <div>
                <span class="bg-indigo-500/30 text-indigo-200 text-[10px] uppercase font-bold tracking-widest px-2.5 py-1 rounded border border-indigo-400/30 inline-block mb-1">
                    Fiche Individuelle Officielle
                </span>
                <h1 class="text-xl font-extrabold truncate max-w-md">{{ fiangonanaNom }}</h1>
            </div>
            <div class="text-right">
                <span class="text-xs font-mono font-bold text-slate-300 block">ID #{{ memberId }}</span>
                <span class="text-[10px] text-slate-400 font-medium">Année {{ year }}</span>
            </div>
        </div>

        <!-- Main Fiche Content -->
        <div class="p-6 space-y-6">

            <!-- Profile & Identite -->
            <div class="flex flex-col sm:flex-row items-start space-y-4 sm:space-y-0 sm:space-x-6 pb-6 border-b border-slate-100">
                <div class="flex-shrink-0">
                    {% if photoUrl %}
                        <img src="{{ photoUrl }}" alt="Photo {{ prenom }}" class="w-28 h-36 object-cover rounded-2xl border-2 border-indigo-100 shadow-sm">
                    {% else %}
                        <div class="w-28 h-36 rounded-2xl bg-indigo-50 text-indigo-600 flex flex-col items-center justify-center font-bold border-2 border-indigo-100 shadow-inner">
                            <svg class="w-12 h-12 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            <span class="text-[10px] uppercase font-semibold">Membre</span>
                        </div>
                    {% endif %}
                </div>

                <div class="flex-1 space-y-3">
                    <div>
                        <p class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Nom & Prénom</p>
                        <h2 class="text-2xl font-extrabold text-slate-900 leading-tight">{{ nom }} {{ prenom }}</h2>
                        <div class="flex flex-wrap items-center gap-2 mt-1">
                            {% if sexe %}
                                <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                    {% if sexe == 'M' %}Homme{% elseif sexe == 'F' %}Femme{% else %}{{ sexe }}{% endif %}
                                </span>
                            {% endif %}
                            {% if age is not null %}
                                <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    {{ age }} ans
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <div>
                            <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold">Email</p>
                            <p class="text-slate-700 font-medium truncate">{{ email }}</p>
                        </div>
                        <div>
                            <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold">Téléphone</p>
                            <p class="text-slate-700 font-medium">{{ telephone }}</p>
                        </div>
                        <div class="sm:col-span-2">
                            <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold">Adresse</p>
                            <p class="text-slate-700 font-medium">{{ adresse }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Affiliations Section -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80">
                    <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold mb-1">Paroisse / Église</p>
                    <p class="text-xs font-bold text-slate-800">{{ fiangonanaNom }}</p>
                </div>
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80">
                    <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold mb-1">Zone / Groupe</p>
                    <p class="text-xs font-bold text-slate-800">{{ groupeNom }}</p>
                </div>
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80">
                    <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold mb-1">Associations</p>
                    <p class="text-xs font-bold text-slate-800 truncate" title="{{ associationsStr }}">{{ associationsStr }}</p>
                </div>
            </div>

            <!-- QR Code & Presence Scan Service -->
            <div class="bg-gradient-to-r from-indigo-50/70 to-blue-50/70 p-4 rounded-2xl border border-indigo-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex-1 space-y-1 text-center sm:text-left">
                    <span class="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-2 py-0.5 rounded border border-indigo-200 uppercase">
                        Code QR & Pointage Présence
                    </span>
                    <h3 class="text-sm font-bold text-slate-800">Scanner pour enregistrer la présence</h3>
                    <p class="text-xs text-slate-600">
                        Lors d'un culte, rassemblement ou formation des jeunes, le responsable scanne ce QR Code pour valider automatiquement la présence.
                    </p>
                    <p class="text-[10px] font-mono text-slate-400">Token: {{ token }}</p>
                </div>
                <div class="flex-shrink-0 bg-white p-2 rounded-xl border border-indigo-100 shadow-sm text-center">
                    <img class="w-28 h-28 mix-blend-multiply mx-auto" src="data:image/png;base64,{{ qrCodeBase64 }}" alt="QR Code Présence Membre" />
                </div>
            </div>

            <!-- Annual Participation & Attendance Statistics -->
            <div class="space-y-3 pt-2">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-800">
                        Assiduité & Participation (Année {{ year }})
                    </h3>
                    <span class="text-[11px] font-bold text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-100">
                        Taux: {{ stats.participationRate|default(0) }}%
                    </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <p class="text-[9px] uppercase font-bold text-slate-400">Événements</p>
                        <p class="text-lg font-black text-slate-800 font-mono">{{ stats.totalActivitiesCount|default(0) }}</p>
                    </div>
                    <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-200">
                        <p class="text-[9px] uppercase font-bold text-emerald-800">Présences</p>
                        <p class="text-lg font-black text-emerald-700 font-mono">{{ stats.attendedActivitiesCount|default(0) }}</p>
                    </div>
                    <div class="bg-indigo-50 p-3 rounded-xl border border-indigo-200">
                        <p class="text-[9px] uppercase font-bold text-indigo-800">À l'Heure</p>
                        <p class="text-lg font-black text-indigo-700 font-mono">{{ stats.onTimeCount|default(0) }}</p>
                    </div>
                    <div class="bg-amber-50 p-3 rounded-xl border border-amber-200">
                        <p class="text-[9px] uppercase font-bold text-amber-800">En Retard</p>
                        <p class="text-lg font-black text-amber-700 font-mono">{{ stats.lateCount|default(0) }}</p>
                    </div>
                </div>

                <!-- Entity Breakdown if available -->
                {% if stats.entityStats is defined %}
                    <div class="pt-2">
                        <p class="text-[10px] uppercase font-bold text-slate-400 mb-2">Détail par Entité</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                            {% for assoc in stats.entityStats.associations|default([]) %}
                                <div class="flex justify-between items-center p-2 rounded-lg bg-slate-50 border border-slate-100">
                                    <span class="font-medium text-slate-700 truncate max-w-[150px]">{{ assoc.nom }}</span>
                                    <span class="font-bold text-indigo-700 font-mono">{{ assoc.presenceRate }}% ({{ assoc.attended }}/{{ assoc.totalEvents }})</span>
                                </div>
                            {% endfor %}
                            {% if stats.entityStats.groupe %}
                                <div class="flex justify-between items-center p-2 rounded-lg bg-slate-50 border border-slate-100">
                                    <span class="font-medium text-slate-700">Zone : {{ stats.entityStats.groupe.nom }}</span>
                                    <span class="font-bold text-amber-700 font-mono">{{ stats.entityStats.groupe.presenceRate }}%</span>
                                </div>
                            {% endif %}
                            {% if stats.entityStats.fiangonana %}
                                <div class="flex justify-between items-center p-2 rounded-lg bg-slate-50 border border-slate-100">
                                    <span class="font-medium text-slate-700">Paroisse : {{ stats.entityStats.fiangonana.nom }}</span>
                                    <span class="font-bold text-emerald-700 font-mono">{{ stats.entityStats.fiangonana.presenceRate }}%</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>

        </div>

        <!-- Fiche Footer -->
        <div class="bg-slate-50 px-6 py-3 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-500">
            <span>Fiche émise pour ID #{{ memberId }}</span>
            <span class="font-medium">Validité Officielle</span>
        </div>
    </div>

</body>
</html>
